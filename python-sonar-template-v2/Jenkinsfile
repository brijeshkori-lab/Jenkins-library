pipeline {

    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
        disableConcurrentBuilds()
    }

    environment {

        // ============================================================
        // JFROG
        // ============================================================

        JFROG_URL = 'https://trialn4vk2g.jfrog.io'

        JFROG_SERVER = 'python-server'

        JFROG_VIRTUAL_REPO = 'python-virtual'

        // ============================================================
        // PYTHON
        // ============================================================

        CI_VENV = '.ci-venv'

        PYTHON_COMMAND = 'python3'

        // ============================================================
        // JFROG BUILD INFO
        // ============================================================

        JFROG_CLI_BUILD_NUMBER = "${BUILD_NUMBER}"
    }

    stages {

        // ============================================================
        // 1. PROD SAFETY
        // ============================================================

        stage('PROD Safety Guard') {

            steps {

                script {

                    echo """
====================================================
PRODUCTION SAFETY CHECK
====================================================

Environment : ${params.ENVIRONMENT}
Final Run   : ${params.IS_FINAL_RUN}

====================================================
"""

                    if (
                        params.ENVIRONMENT == 'PROD' &&
                        params.IS_FINAL_RUN != 'true'
                    ) {

                        error(
                            'PROD requires IS_FINAL_RUN=true.'
                        )
                    }

                    if (
                        params.ENVIRONMENT == 'DEV' &&
                        params.IS_FINAL_RUN == 'true'
                    ) {

                        error(
                            'IS_FINAL_RUN=true is only allowed for PROD.'
                        )
                    }

                    echo 'PROD SAFETY CHECK PASSED'
                }
            }
        }


        // ============================================================
        // 2. INITIALIZE
        // ============================================================

        stage('Initialize') {

            steps {

                script {

                    if (!params.PROJECT_URL?.trim()) {

                        error(
                            'PROJECT_URL is required.'
                        )
                    }


                    def cleanUrl =
                        params.PROJECT_URL
                            .trim()
                            .replaceAll(/\/+$/, '')
                            .replaceAll(/\.git$/, '')


                    def projectName =
                        cleanUrl.tokenize('/')[-1]


                    if (!projectName?.trim()) {

                        error(
                            'Unable to derive project name from PROJECT_URL.'
                        )
                    }


                    env.PROJECT_NAME =
                        projectName


                    env.PROJECT_FOLDER =
                        projectName


                    // Example:
                    // python-app-template
                    //        ↓
                    // pythonapptemplate

                    env.JFROG_PROJECT =
                        projectName
                            .toLowerCase()
                            .replaceAll(/[^a-z0-9]/, '')


                    // Example:
                    //
                    // DEV  -> python-app-template-DEV
                    // PROD -> python-app-template-PROD

                    env.JFROG_LOCAL_REPO =
                        "${projectName}-${params.ENVIRONMENT}"


                    env.JFROG_CLI_BUILD_NAME =
                        projectName


                    env.JFROG_CLI_BUILD_NUMBER =
                        "${BUILD_NUMBER}"


                    echo """
====================================================
PYTHON V2 CI/CD INITIALIZATION
====================================================

Project URL        : ${params.PROJECT_URL}

Git Branch         : main

Project Name       : ${env.PROJECT_NAME}

Project Folder     : ${env.PROJECT_FOLDER}

Environment        : ${params.ENVIRONMENT}

Final Run          : ${params.IS_FINAL_RUN}

JFrog URL          : ${JFROG_URL}

JFrog Project      : ${env.JFROG_PROJECT}

JFrog Repository   : ${env.JFROG_LOCAL_REPO}

JFrog Resolve Repo : ${JFROG_VIRTUAL_REPO}

JFrog Build Name   : ${env.JFROG_CLI_BUILD_NAME}

JFrog Build Number : ${env.JFROG_CLI_BUILD_NUMBER}

Artifact Path      :
${env.JFROG_LOCAL_REPO}/${env.PROJECT_FOLDER}/${BUILD_NUMBER}/

====================================================
"""
                }
            }
        }


        // ============================================================
        // 3. PROD APPROVAL
        // ============================================================

        stage('PROD Approval') {

            when {

                expression {

                    params.ENVIRONMENT == 'PROD' &&
                    params.IS_FINAL_RUN == 'true'
                }
            }

            steps {

                script {

                    if (!params.PRIMARY_APPROVER_EMAIL?.trim()) {

                        error(
                            'PRIMARY_APPROVER_EMAIL is required for PROD.'
                        )
                    }


                    if (!params.MANAGER_EMAIL?.trim()) {

                        error(
                            'MANAGER_EMAIL is required for PROD.'
                        )
                    }


                    echo """
====================================================
PRODUCTION APPROVAL REQUIRED
====================================================

Project     : ${env.PROJECT_NAME}

Build       : ${BUILD_NUMBER}

Environment : PROD

====================================================
"""


                    /*
                     * Email notification.
                     *
                     * This does NOT contain approval buttons.
                     * Approval happens inside Jenkins.
                     */

                    mail(

                        to: params.PRIMARY_APPROVER_EMAIL,

                        subject:
                            "PROD APPROVAL REQUIRED - ${env.PROJECT_NAME} #${BUILD_NUMBER}",

                        mimeType: 'text/html',

                        body: """
<h2>Production Approval Required</h2>

<p><b>Project:</b> ${env.PROJECT_NAME}</p>

<p><b>Build:</b> ${BUILD_NUMBER}</p>

<p><b>Environment:</b> PROD</p>

<p>Please open Jenkins and approve the production release.</p>

<p>
<a href="${BUILD_URL}">
Open Jenkins Build
</a>
</p>
"""
                    )


                    def approver = input(

                        message: """
====================================================
PRODUCTION RELEASE APPROVAL
====================================================

Project:
${env.PROJECT_NAME}

Build:
${BUILD_NUMBER}

Environment:
PROD

Approve this release to continue.

====================================================
""",

                        ok: 'APPROVE PROD RELEASE',

                        submitterParameter: 'APPROVER'
                    )


                    env.APPROVED_BY =
                        "${approver}"


                    echo """
====================================================
PRODUCTION RELEASE APPROVED
====================================================

Approved By : ${env.APPROVED_BY}

====================================================
"""


                    mail(

                        to: params.MANAGER_EMAIL,

                        subject:
                            "PROD RELEASE APPROVED - ${env.PROJECT_NAME} #${BUILD_NUMBER}",

                        mimeType: 'text/html',

                        body: """
<h2>Production Release Approved</h2>

<p><b>Project:</b> ${env.PROJECT_NAME}</p>

<p><b>Build:</b> ${BUILD_NUMBER}</p>

<p><b>Approved By:</b> ${env.APPROVED_BY}</p>

<p><b>Environment:</b> PROD</p>

<p>
<a href="${BUILD_URL}">
Open Jenkins Build
</a>
</p>
"""
                    )
                }
            }
        }


        // ============================================================
        // 4. CHECKOUT APPLICATION
        // ============================================================

        stage('Checkout') {

            steps {

                timeout(
                    time: 30,
                    unit: 'MINUTES'
                ) {

                    git(

                        url: params.PROJECT_URL,

                        branch: 'main'
                    )
                }
            }
        }


        // ============================================================
        // 5. PYTHON ENVIRONMENT
        // ============================================================

        stage('Setup Python Environment') {

            steps {

                sh '''

                    set -e

                    echo "======================================"
                    echo "PYTHON ENVIRONMENT"
                    echo "======================================"


                    command -v "${PYTHON_COMMAND}"

                    "${PYTHON_COMMAND}" --version

                    "${PYTHON_COMMAND}" -m pip --version


                    rm -rf "${CI_VENV}"


                    "${PYTHON_COMMAND}" -m venv "${CI_VENV}"


                    "${CI_VENV}/bin/python" --version


                    "${CI_VENV}/bin/python" -m pip install \
                        --upgrade pip


                    echo "Installing CI tooling..."


                    "${CI_VENV}/bin/python" -m pip install \
                        pytest \
                        pytest-cov \
                        build \
                        coverage


                    echo "Verifying pytest..."

                    "${CI_VENV}/bin/python" \
                        -m pytest --version


                    echo "Verifying pytest-cov..."

                    "${CI_VENV}/bin/python" \
                        -m pytest --help | grep -- '--cov'


                    echo "Verifying build..."

                    "${CI_VENV}/bin/python" \
                        -m build --version


                    echo "======================================"
                    echo "PYTHON ENVIRONMENT READY"
                    echo "======================================"

                '''
            }
        }


        // ============================================================
        // 6. CONFIGURE JFROG
        // ============================================================

        stage('Configure JFrog') {

            steps {

                withCredentials([

                    string(
                        credentialsId: 'jfrog-user',
                        variable: 'JFROG_USER'
                    ),

                    string(
                        credentialsId: 'jfrog-token',
                        variable: 'JFROG_TOKEN'
                    )

                ]) {

                    sh '''

                        set -e

                        echo "======================================"
                        echo "CONFIGURING JFROG"
                        echo "======================================"


                        jf config rm "${JFROG_SERVER}" \
                            --quiet || true


                        jf config add "${JFROG_SERVER}" \
                            --url="${JFROG_URL}" \
                            --user="${JFROG_USER}" \
                            --access-token="${JFROG_TOKEN}" \
                            --interactive=false \
                            --overwrite=true


                        jf config use "${JFROG_SERVER}"


                        echo "Testing JFrog connection..."


                        jf rt ping


                        echo "JFrog connection successful."


                        echo "======================================"

                    '''
                }
            }
        }


        // ============================================================
        // 7. INSTALL DEPENDENCIES FROM JFROG
        // ============================================================

        stage('Install Dependencies') {

            steps {

                withCredentials([

                    string(
                        credentialsId: 'jfrog-user',
                        variable: 'JFROG_USER'
                    ),

                    string(
                        credentialsId: 'jfrog-token',
                        variable: 'JFROG_TOKEN'
                    )

                ]) {

                    sh '''

                        set -e

                        echo "======================================"
                        echo "INSTALLING PYTHON DEPENDENCIES"
                        echo "======================================"


                        PYTHON="${CI_VENV}/bin/python"


                        PIP_CONFIG="${WORKSPACE}/${CI_VENV}/pip.conf"


                        cleanup_pip_config() {

                            rm -f "${PIP_CONFIG}"

                        }


                        trap cleanup_pip_config EXIT


                        cat > "${PIP_CONFIG}" <<EOF
[global]
index-url = https://${JFROG_USER}:${JFROG_TOKEN}@trialn4vk2g.jfrog.io/artifactory/${JFROG_VIRTUAL_REPO}/simple
trusted-host = trialn4vk2g.jfrog.io
EOF


                        export PIP_CONFIG_FILE="${PIP_CONFIG}"


                        if [ -f requirements.txt ]; then

                            echo "Found requirements.txt"


                            "${PYTHON}" -m pip install \
                                -r requirements.txt

                        else

                            echo "No requirements.txt found."

                        fi


                        echo "======================================"
                        echo "DEPENDENCIES INSTALLED"
                        echo "======================================"

                    '''
                }
            }
        }


        // ============================================================
        // 8. UNIT TESTS
        // ============================================================

        stage('Unit Tests') {

            steps {

                sh '''

                    set -e

                    echo "======================================"
                    echo "PYTHON UNIT TESTS"
                    echo "======================================"


                    PYTHON="${CI_VENV}/bin/python"


                    export PATH="${WORKSPACE}/${CI_VENV}/bin:${PATH}"


                    export PYTHONPATH="${WORKSPACE}:${PYTHONPATH:-}"


                    echo "Python:"

                    "${PYTHON}" --version


                    echo "Pytest:"

                    "${PYTHON}" -m pytest --version


                    if [ ! -d tests ]; then

                        echo "ERROR: tests directory not found."

                        exit 1

                    fi


                    mkdir -p test-results


                    "${PYTHON}" -m pytest \
                        -v \
                        --junitxml=test-results/pytest-results.xml \
                        --cov=. \
                        --cov-report=xml \
                        --cov-report=term \
                        --cov-fail-under=0


                    echo "======================================"
                    echo "UNIT TESTS PASSED"
                    echo "======================================"

                '''
            }

            post {

                always {

                    junit(
                        allowEmptyResults: true,
                        testResults:
                            'test-results/pytest-results.xml'
                    )


                    archiveArtifacts(
                        artifacts: 'coverage.xml',
                        allowEmptyArchive: true,
                        fingerprint: true
                    )
                }
            }
        }


        // ============================================================
        // 9. BUILD PYTHON PACKAGE
        // ============================================================

        stage('Build Python Package') {

            steps {

                sh '''

                    set -e

                    echo "======================================"
                    echo "BUILDING PYTHON PACKAGE"
                    echo "======================================"


                    PYTHON="${CI_VENV}/bin/python"


                    rm -rf dist build *.egg-info


                    "${PYTHON}" -m build


                    echo "======================================"
                    echo "BUILD OUTPUT"
                    echo "======================================"


                    ls -lah dist


                    if ! ls dist/*.whl >/dev/null 2>&1; then

                        echo "ERROR: Wheel was not generated."

                        exit 1

                    fi


                    if ! ls dist/*.tar.gz >/dev/null 2>&1; then

                        echo "ERROR: Source distribution was not generated."

                        exit 1

                    fi


                    echo "Python package build completed."

                '''
            }

            post {

                success {

                    archiveArtifacts(
                        artifacts: 'dist/*',
                        fingerprint: true
                    )
                }
            }
        }


        // ============================================================
        // 10. READ PACKAGE VERSION
        // ============================================================

        stage('Read Package Version') {

            steps {

                script {

                    def wheelFile = sh(

                        script:
                            'ls dist/*.whl | head -1',

                        returnStdout: true

                    ).trim()


                    def wheelName =
                        wheelFile.tokenize('/')[-1]


                    /*
                     * Expected:
                     *
                     * python_sonar_test-1.0.0-py3-none-any.whl
                     *
                     * token[0] = package name
                     * token[1] = version
                     */

                    def wheelParts =
                        wheelName.tokenize('-')


                    if (wheelParts.size() < 2) {

                        error(
                            "Unable to determine package version from ${wheelName}"
                        )
                    }


                    env.PYTHON_PACKAGE_FILE =
                        wheelFile


                    env.PYTHON_PACKAGE_NAME =
                        wheelParts[0]


                    env.PYTHON_PACKAGE_VERSION =
                        wheelParts[1]


                    echo """
====================================================
PYTHON PACKAGE
====================================================

Package       : ${env.PYTHON_PACKAGE_NAME}

Version       : ${env.PYTHON_PACKAGE_VERSION}

Wheel         : ${env.PYTHON_PACKAGE_FILE}

JFrog Project : ${env.JFROG_PROJECT}

JFrog Repo    : ${env.JFROG_LOCAL_REPO}

JFrog Build   : ${env.JFROG_CLI_BUILD_NAME}/${env.JFROG_CLI_BUILD_NUMBER}

Artifact Path :
${env.JFROG_LOCAL_REPO}/${env.PROJECT_FOLDER}/${BUILD_NUMBER}/

====================================================
"""
                }
            }
        }


        // ============================================================
        // 11. SONARQUBE
        // ============================================================

        stage('SonarQube Analysis') {

            steps {

                script {

                    /*
                     * This is the same Jenkins tool installation that
                     * worked in your previous pipeline.
                     */

                    def scannerHome =
                        tool 'SonarQubeLocal'


                    withSonarQubeEnv('SonarQubeLocal') {

                        withCredentials([

                            string(
                                credentialsId: 'sonar-token',
                                variable: 'SONAR_TOKEN'
                            )

                        ]) {

                            sh """

                                set -e

                                echo "======================================"
                                echo "SONARQUBE ANALYSIS"
                                echo "======================================"

                                echo "Project:"
                                echo "${env.PROJECT_NAME}"

                                echo "Project Key:"
                                echo "${env.PROJECT_NAME}"

                                echo "Scanner:"
                                echo "${scannerHome}/bin/sonar-scanner"

                                echo "Scanner version:"

                                "${scannerHome}/bin/sonar-scanner" --version

                                echo "======================================"
                                echo "STARTING SONARQUBE SCAN"
                                echo "======================================"

                                "${scannerHome}/bin/sonar-scanner" \\
                                    -Dsonar.projectKey="${env.PROJECT_NAME}" \\
                                    -Dsonar.projectName="${env.PROJECT_NAME}" \\
                                    -Dsonar.projectVersion="${env.PYTHON_PACKAGE_VERSION}" \\
                                    -Dsonar.sources=. \\
                                    -Dsonar.sourceEncoding=UTF-8 \\
                                    -Dsonar.token="\${SONAR_TOKEN}" \\
                                    -Dsonar.exclusions="**/.venv/**,**/.ci-venv/**,**/venv/**,**/__pycache__/**,**/.pytest_cache/**,**/tests/**,**/dist/**,**/build/**,**/*.egg-info/**" \\
                                    -Dsonar.python.coverage.reportPaths=coverage.xml

                                echo "======================================"
                                echo "SONARQUBE ANALYSIS COMPLETED"
                                echo "======================================"

                            """
                        }
                    }
                }
            }
        }


        // ============================================================
        // 12. SONAR QUALITY GATE
        // ============================================================

        stage('SonarQube Quality Gate') {

            steps {

                timeout(
                    time: 5,
                    unit: 'MINUTES'
                ) {

                    waitForQualityGate(
                        abortPipeline: true
                    )
                }
            }
        }


        // ============================================================
        // 13. COLLECT JFROG BUILD INFORMATION
        // ============================================================

        stage('Collect JFrog Build Information') {

            steps {

                withCredentials([

                    string(
                        credentialsId: 'jfrog-user',
                        variable: 'JFROG_USER'
                    ),

                    string(
                        credentialsId: 'jfrog-token',
                        variable: 'JFROG_TOKEN'
                    )

                ]) {

                    sh '''

                        set -e

                        echo "======================================"
                        echo "COLLECTING JFROG BUILD INFORMATION"
                        echo "======================================"


                        jf rt build-collect-env \
                            "${JFROG_CLI_BUILD_NAME}" \
                            "${JFROG_CLI_BUILD_NUMBER}"


                        echo "JFrog build environment collected."


                        echo "======================================"

                    '''
                }
            }
        }


        // ============================================================
        // 14. PUBLISH PACKAGE TO JFROG
        // ============================================================

        stage('Publish Package to JFrog') {

            steps {

                withCredentials([

                    string(
                        credentialsId: 'jfrog-user',
                        variable: 'JFROG_USER'
                    ),

                    string(
                        credentialsId: 'jfrog-token',
                        variable: 'JFROG_TOKEN'
                    )

                ]) {

                    sh '''

                        set -e

                        echo "======================================"
                        echo "PUBLISHING PYTHON PACKAGE"
                        echo "======================================"


                        echo "Project:"
                        echo "${PROJECT_NAME}"


                        echo "Version:"
                        echo "${PYTHON_PACKAGE_VERSION}"


                        echo "JFrog Project:"
                        echo "${JFROG_PROJECT}"


                        echo "Repository:"
                        echo "${JFROG_LOCAL_REPO}"


                        echo "Build:"
                        echo "${JFROG_CLI_BUILD_NAME}/${JFROG_CLI_BUILD_NUMBER}"


                        echo "Artifact Path:"
                        echo "${JFROG_LOCAL_REPO}/${PROJECT_FOLDER}/${BUILD_NUMBER}/"


                        # ------------------------------------------------
                        # Wheel
                        # ------------------------------------------------

                        jf rt upload \
                            "dist/*.whl" \
                            "${JFROG_LOCAL_REPO}/${PROJECT_FOLDER}/${BUILD_NUMBER}/" \
                            --flat=true \
                            --server-id="${JFROG_SERVER}" \
                            --build-name="${JFROG_CLI_BUILD_NAME}" \
                            --build-number="${JFROG_CLI_BUILD_NUMBER}"


                        # ------------------------------------------------
                        # Source distribution
                        # ------------------------------------------------

                        jf rt upload \
                            "dist/*.tar.gz" \
                            "${JFROG_LOCAL_REPO}/${PROJECT_FOLDER}/${BUILD_NUMBER}/" \
                            --flat=true \
                            --server-id="${JFROG_SERVER}" \
                            --build-name="${JFROG_CLI_BUILD_NAME}" \
                            --build-number="${JFROG_CLI_BUILD_NUMBER}"


                        # ------------------------------------------------
                        # Publish Build Info
                        # ------------------------------------------------

                        jf rt build-publish \
                            "${JFROG_CLI_BUILD_NAME}" \
                            "${JFROG_CLI_BUILD_NUMBER}"


                        echo "======================================"
                        echo "JFROG PACKAGE PUBLISH COMPLETED"
                        echo "======================================"

                    '''
                }
            }
        }


        // ============================================================
        // 15. XRAY
        // ============================================================

        stage('Xray Scan') {

            steps {

                withCredentials([

                    string(
                        credentialsId: 'jfrog-user',
                        variable: 'JFROG_USER'
                    ),

                    string(
                        credentialsId: 'jfrog-token',
                        variable: 'JFROG_TOKEN'
                    )

                ]) {

                    sh '''

                        set -e

                        echo "======================================"
                        echo "JFROG XRAY SCAN"
                        echo "======================================"


                        echo "Build:"
                        echo "${JFROG_CLI_BUILD_NAME}/${JFROG_CLI_BUILD_NUMBER}"


                        jf rt build-scan \
                            "${JFROG_CLI_BUILD_NAME}" \
                            "${JFROG_CLI_BUILD_NUMBER}" \
                            --server-id="${JFROG_SERVER}"


                        echo "======================================"
                        echo "XRAY SCAN COMPLETED"
                        echo "======================================"

                    '''
                }
            }
        }


        // ============================================================
        // 16. GENERATE SBOM
        // ============================================================

        stage('Generate SBOM') {

            steps {

                sh '''

                    set -e

                    echo "======================================"
                    echo "GENERATING PYTHON SBOM"
                    echo "======================================"


                    PYTHON="${CI_VENV}/bin/python"


                    "${PYTHON}" -m pip install \
                        cyclonedx-bom


                    "${CI_VENV}/bin/cyclonedx-py" \
                        environment \
                        --output-format json \
                        --output-file cyclonedx-sbom.json


                    test -s cyclonedx-sbom.json


                    echo "SBOM generated."


                    ls -lah cyclonedx-sbom.json


                    echo "======================================"

                '''
            }

            post {

                always {

                    archiveArtifacts(

                        artifacts:
                            'cyclonedx-sbom.json',

                        allowEmptyArchive: true,

                        fingerprint: true
                    )
                }
            }
        }


        // ============================================================
        // 17. PUBLISH SBOM
        // ============================================================

        stage('Publish SBOM') {

            steps {

                withCredentials([

                    string(
                        credentialsId: 'jfrog-user',
                        variable: 'JFROG_USER'
                    ),

                    string(
                        credentialsId: 'jfrog-token',
                        variable: 'JFROG_TOKEN'
                    )

                ]) {

                    sh '''

                        set -e

                        echo "======================================"
                        echo "PUBLISHING SBOM"
                        echo "======================================"


                        jf rt upload \
                            "cyclonedx-sbom.json" \
                            "${JFROG_LOCAL_REPO}/${PROJECT_FOLDER}/${BUILD_NUMBER}/sbom/" \
                            --flat=true \
                            --server-id="${JFROG_SERVER}" \
                            --build-name="${JFROG_CLI_BUILD_NAME}" \
                            --build-number="${JFROG_CLI_BUILD_NUMBER}"


                        echo "SBOM published."


                        echo "======================================"

                    '''
                }
            }
        }


        // ============================================================
        // 18. PROD RELEASE
        // ============================================================

        stage('Production Release') {

            when {

                expression {

                    params.ENVIRONMENT == 'PROD' &&
                    params.IS_FINAL_RUN == 'true'
                }
            }

            steps {

                echo """
====================================================
PRODUCTION RELEASE COMPLETED
====================================================

Project       : ${env.PROJECT_NAME}

Build         : ${BUILD_NUMBER}

Version       : ${env.PYTHON_PACKAGE_VERSION}

Approved By   : ${env.APPROVED_BY}

JFrog Project : ${env.JFROG_PROJECT}

JFrog Repo    : ${env.JFROG_LOCAL_REPO}

Artifact Path :
${env.JFROG_LOCAL_REPO}/${env.PROJECT_FOLDER}/${BUILD_NUMBER}/

====================================================
"""
            }
        }
    }


    // ================================================================
    // POST
    // ================================================================

    post {

        success {

            echo """
====================================================
PYTHON V2 PIPELINE SUCCESS
====================================================

Project       : ${env.PROJECT_NAME}

Build         : ${BUILD_NUMBER}

Environment   : ${params.ENVIRONMENT}

Package       : ${env.PYTHON_PACKAGE_NAME}

Version       : ${env.PYTHON_PACKAGE_VERSION}

JFrog Project : ${env.JFROG_PROJECT}

JFrog Repo    : ${env.JFROG_LOCAL_REPO}

JFrog Build   :
${env.JFROG_CLI_BUILD_NAME}/${env.JFROG_CLI_BUILD_NUMBER}

Artifact Path :
${env.JFROG_LOCAL_REPO}/${env.PROJECT_FOLDER}/${BUILD_NUMBER}/

====================================================
"""
        }


        failure {

            echo """
====================================================
PYTHON V2 PIPELINE FAILED
====================================================

Project     : ${env.PROJECT_NAME}

Build       : ${BUILD_NUMBER}

Environment : ${params.ENVIRONMENT}

Check the failed stage above.

====================================================
"""
        }


        always {

            sh '''

                rm -rf .ci-venv || true
                rm -rf .venv || true
                rm -rf __pycache__ || true
                rm -rf .pytest_cache || true
                rm -rf build || true
                rm -rf *.egg-info || true

            '''
        }
    }
}