pipeline {

    agent any

    parameters {

        string(
            name: 'PROJECT_URL',
            defaultValue: '',
            description: 'Git URL of the Python application'
        )

        choice(
            name: 'ENVIRONMENT',
            choices: ['DEV', 'PROD'],
            description: 'Target environment'
        )

        choice(
            name: 'IS_FINAL_RUN',
            choices: ['false', 'true'],
            description: 'Set true only for the final PROD release'
        )

        string(
            name: 'PRIMARY_APPROVER_EMAIL',
            defaultValue: '',
            description: 'Required for PROD final run'
        )

        string(
            name: 'MANAGER_EMAIL',
            defaultValue: '',
            description: 'Manager notification email'
        )

        string(
            name: 'TO_EMAIL',
            defaultValue: '',
            description: 'Pipeline notification recipients'
        )

        string(
            name: 'CC_EMAIL',
            defaultValue: '',
            description: 'CC notification recipients'
        )
    }

    environment {

        // =========================================================
        // PYTHON
        // =========================================================

        CI_VENV = '.ci-venv'
        PYTHON_COMMAND = 'python3'


        // =========================================================
        // JFROG CLOUD
        // =========================================================

        JFROG_URL = 'https://trialn4vk2g.jfrog.io'

        JFROG_SERVER = 'python-server'

        JFROG_VIRTUAL_REPO = 'python-virtual'
        JFROG_REMOTE_REPO  = 'python-remote'


        // =========================================================
        // BUILD INFO
        // =========================================================

        JFROG_CLI_BUILD_NUMBER = "${BUILD_NUMBER}"
    }


    stages {

        // =========================================================
        // PROD SAFETY GUARD
        // =========================================================

        stage('PROD Safety Guard') {

            steps {

                script {

                    echo """
====================================================
PRODUCTION SAFETY CHECK
====================================================

Environment : ${params.ENVIRONMENT}
Final Run   : ${params.IS_FINAL_RUN}

====================================================
"""

                    if (
                        params.ENVIRONMENT == 'PROD' &&
                        params.IS_FINAL_RUN != 'true'
                    ) {

                        error("""
====================================================
PRODUCTION DEPLOYMENT BLOCKED
====================================================

PROD requires:

ENVIRONMENT  = PROD
IS_FINAL_RUN = true

====================================================
""")
                    }

                    if (
                        params.ENVIRONMENT == 'DEV' &&
                        params.IS_FINAL_RUN == 'true'
                    ) {

                        error("""
====================================================
INVALID FINAL RUN
====================================================

IS_FINAL_RUN=true is only allowed for PROD.

====================================================
""")
                    }
                }
            }
        }


        // =========================================================
        // INITIALIZE PROJECT
        // =========================================================

        stage('Initialize') {

            steps {

                script {

                    def cleanUrl =
                        params.PROJECT_URL
                            .trim()
                            .replaceAll(/\/$/, '')
                            .replaceAll(/\.git$/, '')

                    def projectName =
                        cleanUrl.tokenize('/')[-1]

                    if (!projectName?.trim()) {

                        error(
                            'Unable to derive project name from PROJECT_URL'
                        )
                    }

                    /*
                     * Python project
                     *
                     * example:
                     *
                     * python-app-template
                     */

                    env.PROJECT_NAME = projectName

                    /*
                     * Reference terminology:
                     *
                     * PROJECT_FOLDER = application/build-info name
                     */

                    env.PROJECT_FOLDER = projectName

                    /*
                     * JFrog project key
                     *
                     * python-app-template
                     *        ↓
                     * pythonapptemplate
                     */

                    env.JFROG_PROJECT_KEY =
                        projectName
                            .toLowerCase()
                            .replaceAll('[^a-z0-9]', '')

                    /*
                     * IMPORTANT:
                     *
                     * This matches the Java reference:
                     *
                     * <PROJECT_NAME>-<ENVIRONMENT>
                     */

                    env.ARTIFACTORY_REPO =
                        "${env.PROJECT_NAME}-${params.ENVIRONMENT}"

                    /*
                     * Build name is the project folder.
                     */

                    env.JFROG_CLI_BUILD_NAME =
                        env.PROJECT_FOLDER


                    echo """
====================================================
PYTHON V2 INITIALIZATION
====================================================

Project URL       : ${params.PROJECT_URL}
Project Name      : ${env.PROJECT_NAME}
Project Folder    : ${env.PROJECT_FOLDER}

Environment       : ${params.ENVIRONMENT}
Final Run         : ${params.IS_FINAL_RUN}

JFrog Project     : ${env.JFROG_PROJECT_KEY}
JFrog Repository  : ${env.ARTIFACTORY_REPO}

Build Name        : ${env.JFROG_CLI_BUILD_NAME}
Build Number      : ${BUILD_NUMBER}

Dependency Repo   : ${env.JFROG_VIRTUAL_REPO}

====================================================
"""
                }
            }
        }


        // =========================================================
        // PROD APPROVAL
        // =========================================================

        stage('PROD Approval') {

            when {

                expression {

                    params.ENVIRONMENT == 'PROD' &&
                    params.IS_FINAL_RUN == 'true'
                }
            }

            steps {

                script {

                    if (!params.PRIMARY_APPROVER_EMAIL?.trim()) {

                        error(
                            'PRIMARY_APPROVER_EMAIL is required for PROD.'
                        )
                    }

                    if (!params.MANAGER_EMAIL?.trim()) {

                        error(
                            'MANAGER_EMAIL is required for PROD.'
                        )
                    }


                    mail(

                        to: params.PRIMARY_APPROVER_EMAIL,

                        subject:
                            "PROD APPROVAL REQUIRED - ${env.PROJECT_NAME} #${BUILD_NUMBER}",

                        mimeType: 'text/html',

                        body: """
<h2>Production Approval Required</h2>

<p><b>Project:</b> ${env.PROJECT_NAME}</p>
<p><b>Build:</b> ${BUILD_NUMBER}</p>
<p><b>Environment:</b> PROD</p>

<p>
<a href="${BUILD_URL}">
Open Jenkins Build
</a>
</p>

<p>Please review and approve the build in Jenkins.</p>
"""
                    )


                    def approver = input(

                        message: """
====================================================
PRODUCTION RELEASE APPROVAL
====================================================

Project     : ${env.PROJECT_NAME}
Build       : ${BUILD_NUMBER}
Environment : PROD

Approve this build to continue.

====================================================
""",

                        ok: 'APPROVE PROD RELEASE',

                        submitter:
                            'primary-approver,admin,devops-admin',

                        submitterParameter: 'APPROVER'
                    )


                    env.APPROVED_BY = approver


                    echo """
====================================================
PRODUCTION RELEASE APPROVED
====================================================

Approved By : ${approver}
Build       : ${BUILD_NUMBER}

====================================================
"""


                    mail(

                        to: params.MANAGER_EMAIL,

                        subject:
                            "PROD RELEASE APPROVED - ${env.PROJECT_NAME} #${BUILD_NUMBER}",

                        mimeType: 'text/html',

                        body: """
<h2>Production Release Approved</h2>

<p><b>Project:</b> ${env.PROJECT_NAME}</p>
<p><b>Build:</b> ${BUILD_NUMBER}</p>
<p><b>Approved By:</b> ${approver}</p>
<p><b>Environment:</b> PROD</p>

<p>
<a href="${BUILD_URL}">
Open Jenkins Build
</a>
</p>
"""
                    )
                }
            }
        }


        // =========================================================
        // CHECKOUT
        // =========================================================

        stage('Checkout') {

            steps {

                git(
                    url: params.PROJECT_URL,
                    branch: '*/main'
                )
            }
        }


        // =========================================================
        // PYTHON ENVIRONMENT
        // =========================================================

        stage('Setup Python Environment') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "PYTHON ENVIRONMENT"
                    echo "======================================"

                    command -v "${PYTHON_COMMAND}"

                    "${PYTHON_COMMAND}" --version

                    "${PYTHON_COMMAND}" -m pip --version

                    rm -rf "${CI_VENV}"

                    "${PYTHON_COMMAND}" -m venv "${CI_VENV}"

                    "${CI_VENV}/bin/python" --version

                    "${CI_VENV}/bin/python" \
                        -m pip install --upgrade pip

                    echo "Installing CI tooling..."

                    "${CI_VENV}/bin/python" -m pip install \
                        pytest \
                        pytest-cov \
                        build \
                        coverage

                    echo "Verifying pytest..."

                    "${CI_VENV}/bin/python" \
                        -m pytest --version

                    echo "Verifying pytest-cov..."

                    "${CI_VENV}/bin/python" \
                        -m pytest --help | grep -- '--cov'

                    echo "Verifying build..."

                    "${CI_VENV}/bin/python" \
                        -m build --version

                    echo "======================================"
                    echo "PYTHON ENVIRONMENT READY"
                    echo "======================================"
                '''
            }
        }


        // =========================================================
        // CONFIGURE JFROG
        // =========================================================

        stage('Configure JFrog') {

            steps {

                withCredentials([

                    string(
                        credentialsId: 'jfrog-user',
                        variable: 'JFROG_USER'
                    ),

                    string(
                        credentialsId: 'jfrog-token',
                        variable: 'JFROG_TOKEN'
                    )

                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "CONFIGURING JFROG"
                        echo "======================================"

                        jf config rm "${JFROG_SERVER}" \
                            --quiet || true

                        jf config add "${JFROG_SERVER}" \
                            --url="${JFROG_URL}" \
                            --user="${JFROG_USER}" \
                            --access-token="${JFROG_TOKEN}" \
                            --interactive=false \
                            --overwrite=true

                        jf config use "${JFROG_SERVER}"

                        echo "Testing JFrog..."

                        jf rt ping

                        echo "JFrog connection successful."

                        echo "======================================"
                    '''
                }
            }
        }


        // =========================================================
        // DEPENDENCIES FROM JFROG VIRTUAL
        // =========================================================

        stage('Install Dependencies') {

            steps {

                withCredentials([

                    string(
                        credentialsId: 'jfrog-user',
                        variable: 'JFROG_USER'
                    ),

                    string(
                        credentialsId: 'jfrog-token',
                        variable: 'JFROG_TOKEN'
                    )

                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "INSTALLING PYTHON DEPENDENCIES"
                        echo "======================================"

                        PYTHON="${WORKSPACE}/${CI_VENV}/bin/python"

                        PIP_CONFIG="${WORKSPACE}/${CI_VENV}/pip.conf"

                        cleanup_pip_config() {

                            rm -f "${PIP_CONFIG}"

                        }

                        trap cleanup_pip_config EXIT


                        cat > "${PIP_CONFIG}" <<EOF
[global]
index-url = https://${JFROG_USER}:${JFROG_TOKEN}@trialn4vk2g.jfrog.io/artifactory/${JFROG_VIRTUAL_REPO}/simple
EOF

                        export PIP_CONFIG_FILE="${PIP_CONFIG}"


                        if [ -f requirements.txt ]; then

                            echo "Found requirements.txt"

                            "${PYTHON}" \
                                -m pip install \
                                -r requirements.txt

                        elif [ -f pyproject.toml ]; then

                            echo "Found pyproject.toml"

                            "${PYTHON}" \
                                -m pip install .

                        else

                            echo "No dependency file found."

                        fi


                        echo "======================================"
                        echo "DEPENDENCIES INSTALLED"
                        echo "======================================"
                    '''
                }
            }
        }


        // =========================================================
        // UNIT TESTS
        // =========================================================

        stage('Unit Tests') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "PYTHON UNIT TESTS"
                    echo "======================================"

                    PYTHON="${WORKSPACE}/${CI_VENV}/bin/python"

                    export PATH="${WORKSPACE}/${CI_VENV}/bin:${PATH}"

                    export PYTHONPATH="${WORKSPACE}:${PYTHONPATH:-}"

                    "${PYTHON}" --version

                    "${PYTHON}" -m pytest --version


                    if [ ! -d tests ]; then

                        echo "ERROR: tests directory not found."

                        exit 1

                    fi


                    mkdir -p test-results


                    "${PYTHON}" -m pytest \
                        -v \
                        --junitxml=test-results/pytest-results.xml \
                        --cov=. \
                        --cov-report=xml \
                        --cov-report=term \
                        --cov-fail-under=0


                    echo "======================================"
                    echo "UNIT TESTS PASSED"
                    echo "======================================"
                '''
            }

            post {

                always {

                    junit(
                        allowEmptyResults: true,
                        testResults:
                            'test-results/pytest-results.xml'
                    )

                    archiveArtifacts(
                        artifacts: 'coverage.xml',
                        allowEmptyArchive: true,
                        fingerprint: true
                    )
                }
            }
        }


        // =========================================================
        // BUILD PYTHON PACKAGE
        // =========================================================

        stage('Build Python Package') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "BUILDING PYTHON PACKAGE"
                    echo "======================================"

                    rm -rf dist build *.egg-info

                    "${WORKSPACE}/${CI_VENV}/bin/python" \
                        -m build

                    echo "======================================"
                    echo "BUILD OUTPUT"
                    echo "======================================"

                    ls -lah dist


                    if ! ls dist/*.whl >/dev/null 2>&1; then

                        echo "ERROR: Wheel not generated."

                        exit 1

                    fi


                    if ! ls dist/*.tar.gz >/dev/null 2>&1; then

                        echo "ERROR: Source distribution not generated."

                        exit 1

                    fi
                '''
            }
        }


        // =========================================================
        // PACKAGE INFORMATION
        // =========================================================

        stage('Read Package Version') {

            steps {

                script {

                    def wheelFile = sh(

                        script:
                            'ls dist/*.whl | head -1',

                        returnStdout: true
                    ).trim()


                    def wheelName =
                        wheelFile.tokenize('/').last()


                    def match =
                        wheelName =~ /^(.+)-([0-9][^-]*)-.*\\.whl$/


                    if (!match) {

                        error(
                            "Unable to determine package/version from ${wheelName}"
                        )
                    }


                    env.PYTHON_PACKAGE_NAME =
                        match[0][1]

                    env.PYTHON_PACKAGE_VERSION =
                        match[0][2]

                    env.PYTHON_WHEEL =
                        wheelName


                    echo """
====================================================
PYTHON PACKAGE
====================================================

Package       : ${env.PYTHON_PACKAGE_NAME}
Version       : ${env.PYTHON_PACKAGE_VERSION}

Wheel         : dist/${env.PYTHON_WHEEL}

Repository    : ${env.ARTIFACTORY_REPO}

Artifact Path :
${env.ARTIFACTORY_REPO}/${env.PROJECT_FOLDER}/${BUILD_NUMBER}/

====================================================
"""
                }
            }
        }


        // =========================================================
        // COLLECT JFROG BUILD INFORMATION
        // =========================================================

        stage('Collect JFrog Build Information') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "COLLECTING JFROG BUILD INFORMATION"
                    echo "======================================"

                    jf rt build-collect-env \
                        "${JFROG_CLI_BUILD_NAME}" \
                        "${BUILD_NUMBER}"

                    echo "JFrog environment collected."
                '''
            }
        }


        // =========================================================
        // UPLOAD ARTIFACTS
        // =========================================================
        //
        // SAME STORAGE MODEL AS REFERENCE:
        //
        // <PROJECT_NAME>-<ENVIRONMENT>/
        //      <PROJECT_FOLDER>/
        //          <BUILD_NUMBER>/
        //              artifact
        //
        // =========================================================

        stage('Publish Package to JFrog') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "PUBLISHING PYTHON PACKAGE"
                    echo "======================================"

                    REPO="${ARTIFACTORY_REPO}"

                    TARGET="${REPO}/${PROJECT_FOLDER}/${BUILD_NUMBER}/"

                    echo "Repository : ${REPO}"
                    echo "Build Name : ${PROJECT_FOLDER}"
                    echo "Build No   : ${BUILD_NUMBER}"
                    echo "Target     : ${TARGET}"


                    for FILE in dist/*; do

                        if [ -f "${FILE}" ]; then

                            FILE_NAME=$(basename "${FILE}")

                            echo "Uploading ${FILE_NAME}"


                            jf rt upload \
                                "${FILE}" \
                                "${TARGET}${FILE_NAME}" \
                                --flat=true \
                                --build-name="${PROJECT_FOLDER}" \
                                --build-number="${BUILD_NUMBER}"


                        fi

                    done


                    echo "======================================"
                    echo "PYTHON PACKAGE PUBLISHED"
                    echo "======================================"
                '''
            }
        }


        // =========================================================
        // PUBLISH BUILD INFO
        // =========================================================

        stage('Publish JFrog Build Info') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "PUBLISHING JFROG BUILD INFO"
                    echo "======================================"

                    jf rt build-publish \
                        "${PROJECT_FOLDER}" \
                        "${BUILD_NUMBER}"

                    echo "======================================"
                    echo "BUILD INFO PUBLISHED"
                    echo "======================================"
                '''
            }
        }


        // =========================================================
        // XRAY
        // =========================================================

        stage('Xray Scan') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "XRAY BUILD SCAN"
                    echo "======================================"

                    jf bs \
                        "${PROJECT_FOLDER}" \
                        "${BUILD_NUMBER}"

                    echo "======================================"
                    echo "XRAY SCAN COMPLETED"
                    echo "======================================"
                '''
            }
        }


        // =========================================================
        // SBOM
        // =========================================================

        stage('Generate SBOM') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "GENERATING SBOM"
                    echo "======================================"

                    PYTHON="${WORKSPACE}/${CI_VENV}/bin/python"


                    "${PYTHON}" -m pip install \
                        cyclonedx-bom


                    "${CI_VENV}/bin/cyclonedx-py" \
                        environment \
                        --output-format json \
                        --output-file cyclonedx-sbom.json


                    ls -lah cyclonedx-sbom.json

                    echo "SBOM generated."

                    echo "======================================"
                '''
            }

            post {

                always {

                    archiveArtifacts(
                        artifacts:
                            'cyclonedx-sbom.json',

                        allowEmptyArchive: true,

                        fingerprint: true
                    )
                }
            }
        }


        // =========================================================
        // PUBLISH SBOM
        // =========================================================
        //
        // SAME PATH MODEL:
        //
        // <REPO>/<PROJECT_FOLDER>/<BUILD_NUMBER>/sbom/
        //
        // =========================================================

        stage('Publish SBOM') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "PUBLISHING SBOM"
                    echo "======================================"

                    TARGET="${ARTIFACTORY_REPO}/${PROJECT_FOLDER}/${BUILD_NUMBER}/sbom/"

                    jf rt upload \
                        "cyclonedx-sbom.json" \
                        "${TARGET}cyclonedx-sbom.json" \
                        --flat=true

                    echo "SBOM published."

                    echo "======================================"
                '''
            }
        }


        // =========================================================
        // FINAL RELEASE
        // =========================================================

        stage('Production Release') {

            when {

                expression {

                    params.ENVIRONMENT == 'PROD' &&
                    params.IS_FINAL_RUN == 'true'
                }
            }

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "PRODUCTION RELEASE"
                    echo "======================================"

                    RB_NAME="${PROJECT_FOLDER}-rb"

                    RB_VERSION="${BUILD_NUMBER}"


                    echo "Release Bundle : ${RB_NAME}"
                    echo "Version        : ${RB_VERSION}"
                    echo "Project        : ${JFROG_PROJECT_KEY}"


                    jf rbc \
                        "${RB_NAME}" \
                        "${RB_VERSION}" \
                        --build-name="${PROJECT_FOLDER}" \
                        --build-number="${BUILD_NUMBER}" \
                        --sync


                    echo "======================================"
                    echo "RELEASE BUNDLE CREATED"
                    echo "======================================"
                '''
            }
        }
    }


    // =============================================================
    // POST
    // =============================================================

    post {

        success {

            script {

                echo """
====================================================
PYTHON V2 PIPELINE SUCCESS
====================================================

Project       : ${env.PROJECT_NAME}
Build         : ${BUILD_NUMBER}
Environment   : ${params.ENVIRONMENT}

Package       : ${env.PYTHON_PACKAGE_NAME}
Version       : ${env.PYTHON_PACKAGE_VERSION}

JFrog Repo    : ${env.ARTIFACTORY_REPO}

Artifact Path :
${env.ARTIFACTORY_REPO}/${env.PROJECT_FOLDER}/${BUILD_NUMBER}/

====================================================
"""
            }
        }


        failure {

            echo """
====================================================
PYTHON V2 PIPELINE FAILED
====================================================

Project     : ${env.PROJECT_NAME ?: 'Unknown'}
Build       : ${BUILD_NUMBER}
Environment : ${params.ENVIRONMENT}

Check the failed stage and Jenkins console.

====================================================
"""
        }


        always {

            sh '''
                rm -rf "${CI_VENV}" || true
                rm -rf .pytest_cache || true
                rm -rf __pycache__ || true
                rm -rf build || true
                rm -rf *.egg-info || true
            '''
        }
    }
}