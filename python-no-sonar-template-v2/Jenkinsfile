pipeline {

    agent any

    parameters {

        string(
            name: 'PROJECT_URL',
            defaultValue: '',
            description: 'GitHub repository URL of the Python project'
        )

        choice(
            name: 'ENVIRONMENT',
            choices: ['DEV', 'PROD'],
            description: 'Select deployment environment'
        )

        choice(
            name: 'IS_FINAL_RUN',
            choices: ['false', 'true'],
            description: 'Select true only for final PROD release'
        )

        string(
            name: 'PRIMARY_APPROVER_EMAIL',
            defaultValue: '',
            description: 'Primary PROD approval email'
        )

        string(
            name: 'MANAGER_EMAIL',
            defaultValue: '',
            description: 'Manager notification email'
        )

        string(
            name: 'TO_EMAIL',
            defaultValue: '',
            description: 'Pipeline notification recipients'
        )

        string(
            name: 'CC_EMAIL',
            defaultValue: '',
            description: 'Pipeline notification CC recipients'
        )
    }

    environment {

        /*
         * =========================================================
         * PYTHON
         * =========================================================
         */

        CI_VENV = '.ci-venv'

        /*
         * =========================================================
         * JFROG
         * =========================================================
         */

        JFROG_URL = 'https://trialn4vk2g.jfrog.io/artifactory'

        JFROG_PLATFORM_URL = 'https://trialn4vk2g.jfrog.io'

        JFROG_SERVER_ID = 'python-server'

        JFROG_TOKEN_ID = 'jfrog-token'

        JFROG_USER_ID = 'jfrog-user'

        JFROG_DEPENDENCY_REPO = 'python-virtual'

        /*
         * =========================================================
         * SONARQUBE
         * =========================================================
         */

        SONAR_SERVER = 'SonarQubeLocal'

        SONAR_TOKEN_ID = 'sonar-token'

        /*
         * =========================================================
         * VERSION
         * =========================================================
         */

        PROJECT_VERSION = '1'
    }


    stages {


        // =========================================================
        // PROD SAFETY
        // =========================================================

        stage('PROD Safety Guard') {

            steps {

                script {

                    if (
                        params.ENVIRONMENT == 'PROD' &&
                        params.IS_FINAL_RUN != 'true'
                    ) {

                        error("""
=======================================
PRODUCTION DEPLOYMENT BLOCKED
=======================================

PROD deployments require:

ENVIRONMENT  = PROD
IS_FINAL_RUN = true

Selected Environment : ${params.ENVIRONMENT}
Final Run            : ${params.IS_FINAL_RUN}

Please correct the parameters and re-run.
=======================================
""")
                    }

                    echo "PROD SAFETY CHECK PASSED"
                }
            }
        }


        // =========================================================
        // FINAL RUN APPROVAL
        // =========================================================

        stage('FINAL RUN Approval Gate') {

            when {

                expression {
                    params.IS_FINAL_RUN == 'true'
                }
            }

            steps {

                script {

                    if (params.ENVIRONMENT != 'PROD') {

                        error("""
FINAL RUN BLOCKED

FINAL RUN can only be executed against PROD.

Environment : ${params.ENVIRONMENT}
""")
                    }

                    if (!params.PROJECT_URL?.trim()) {
                        error('PROJECT_URL is required.')
                    }

                    if (!params.PRIMARY_APPROVER_EMAIL?.trim()) {
                        error(
                            'PRIMARY_APPROVER_EMAIL is required for FINAL RUN.'
                        )
                    }

                    if (!params.MANAGER_EMAIL?.trim()) {
                        error(
                            'MANAGER_EMAIL is required for FINAL RUN.'
                        )
                    }


                    /*
                     * -------------------------------------------------
                     * Derive project information
                     * -------------------------------------------------
                     */

                    def urlParts = params.PROJECT_URL
                        .trim()
                        .replaceAll('/+$', '')
                        .tokenize('/')

                    if (urlParts.size() < 2) {
                        error(
                            "Invalid PROJECT_URL: ${params.PROJECT_URL}"
                        )
                    }

                    def projectName = urlParts[-1]

                    /*
                     * GitHub URLs:
                     *
                     * https://github.com/org/python-app-template
                     *
                     * projectName = python-app-template
                     */

                    env.PROJECT_NAME = projectName

                    /*
                     * For Python we keep the folder equal to the
                     * repository/project name.
                     *
                     * This gives:
                     *
                     * python-app-template/
                     *     BUILD_NUMBER/
                     */

                    env.PROJECT_FOLDER = projectName


                    echo """
=======================================
FINAL RUN APPROVAL REQUIRED
=======================================

Project URL       : ${params.PROJECT_URL}
Project Name      : ${env.PROJECT_NAME}
Project Folder    : ${env.PROJECT_FOLDER}

Environment       : ${params.ENVIRONMENT}
Final Run         : ${params.IS_FINAL_RUN}

Build Number      : ${BUILD_NUMBER}

=======================================
"""


                    /*
                     * -------------------------------------------------
                     * Approval notification
                     * -------------------------------------------------
                     */

                    mail(
                        to: params.PRIMARY_APPROVER_EMAIL,
                        subject:
                            "FINAL RUN APPROVAL REQUIRED - ${env.PROJECT_NAME}",
                        mimeType: 'text/html',
                        body: """
<h2>FINAL RUN APPROVAL REQUIRED</h2>

<p><b>Project:</b> ${env.PROJECT_NAME}</p>
<p><b>Project URL:</b> ${params.PROJECT_URL}</p>
<p><b>Environment:</b> ${params.ENVIRONMENT}</p>
<p><b>Build:</b> ${BUILD_NUMBER}</p>

<p>
<b>Jenkins:</b>
<a href="${BUILD_URL}">
${BUILD_URL}
</a>
</p>

<p>
Please open Jenkins and approve the pending execution.
</p>
"""
                    )


                    /*
                     * -------------------------------------------------
                     * Jenkins manual approval
                     * -------------------------------------------------
                     */

                    def approver = input(
                        message: """
FINAL RUN APPROVAL REQUIRED

Project     : ${env.PROJECT_NAME}
Environment : ${params.ENVIRONMENT}
Build       : ${BUILD_NUMBER}

Only an authorized production approver should approve.
""",
                        ok: 'APPROVE',
                        submitter:
                            'primary-approver,admin,devops-admin',
                        submitterParameter: 'APPROVER'
                    )


                    echo "Approved by: ${approver}"


                    /*
                     * -------------------------------------------------
                     * Manager notification
                     * -------------------------------------------------
                     */

                    mail(
                        to: params.MANAGER_EMAIL,
                        subject:
                            "FINAL RUN STARTED - ${env.PROJECT_NAME}",
                        mimeType: 'text/html',
                        body: """
<h2>FINAL RUN APPROVED</h2>

<p><b>Project:</b> ${env.PROJECT_NAME}</p>
<p><b>Environment:</b> ${params.ENVIRONMENT}</p>
<p><b>Build:</b> ${BUILD_NUMBER}</p>
<p><b>Approved By:</b> ${approver}</p>

<p>
<b>Jenkins:</b>
<a href="${BUILD_URL}">
${BUILD_URL}
</a>
</p>
"""
                    )
                }
            }
        }


        // =========================================================
        // INITIALIZE
        // =========================================================

        stage('Initialize') {

            steps {

                script {

                    if (!params.PROJECT_URL?.trim()) {
                        error('PROJECT_URL is required.')
                    }


                    def cleanUrl = params.PROJECT_URL
                        .trim()
                        .replaceAll('/+$', '')


                    def parts = cleanUrl.tokenize('/')

                    if (parts.size() < 2) {
                        error(
                            "Invalid GitHub PROJECT_URL: ${cleanUrl}"
                        )
                    }


                    /*
                     * Last component becomes project name.
                     */

                    def projectName = parts[-1]


                    /*
                     * Remove .git if supplied.
                     */

                    projectName =
                        projectName.replaceAll(/\.git$/, '')


                    env.PROJECT_NAME = projectName

                    env.PROJECT_FOLDER = projectName


                    /*
                     * JFrog project key
                     *
                     * python-app-template
                     *       ↓
                     * pythonapptemplate
                     */

                    env.JFROG_PROJECT =
                        projectName
                            .toLowerCase()
                            .replaceAll('[^a-z0-9]', '')


                    env.ARTIFACTORY_REPO =
                        "${projectName}-${params.ENVIRONMENT}"


                    env.JFROG_BUILD_NAME =
                        projectName


                    env.JFROG_BUILD_NUMBER =
                        "${BUILD_NUMBER}"


                    env.JFROG_ARTIFACT_PATH =
                        "${env.ARTIFACTORY_REPO}/${env.PROJECT_FOLDER}/${BUILD_NUMBER}"


                    env.SONAR_PROJECT_KEY =
                        projectName


                    env.SONAR_PROJECT_NAME =
                        projectName


                    echo """
====================================================
PYTHON V2 PROJECT INITIALIZATION
====================================================

Project URL       : ${params.PROJECT_URL}

Project Name      : ${env.PROJECT_NAME}
Project Folder    : ${env.PROJECT_FOLDER}

Environment       : ${params.ENVIRONMENT}
Final Run         : ${params.IS_FINAL_RUN}

JFrog Project     : ${env.JFROG_PROJECT}
JFrog Repository  : ${env.ARTIFACTORY_REPO}

JFrog Build Name  : ${env.JFROG_BUILD_NAME}
Jenkins Build     : ${env.JFROG_BUILD_NUMBER}

Dependency Repo   : ${JFROG_DEPENDENCY_REPO}

Sonar Project Key : ${env.SONAR_PROJECT_KEY}

Artifact Path     : ${env.JFROG_ARTIFACT_PATH}

====================================================
"""
                }
            }
        }


        // =========================================================
        // CLEAN WORKSPACE
        // =========================================================

        stage('Clean Workspace') {

            steps {

                sh '''
                    set -e

                    echo "Cleaning workspace..."

                    find . -mindepth 1 -maxdepth 1 \
                        -exec rm -rf {} +

                    echo "Workspace cleaned."
                '''
            }
        }


        // =========================================================
        // CHECKOUT APPLICATION
        // =========================================================

        stage('Checkout') {

            options {
                timeout(
                    time: 30,
                    unit: 'MINUTES'
                )
            }

            steps {

                script {

                    git(
                        url: params.PROJECT_URL,
                        branch: 'main'
                    )
                }
            }
        }


        // =========================================================
        // SETUP PYTHON
        // =========================================================

        stage('Setup Python Environment') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "PYTHON ENVIRONMENT"
                    echo "======================================"

                    command -v python3

                    python3 --version

                    python3 -m pip --version

                    rm -rf "${CI_VENV}"

                    python3 -m venv "${CI_VENV}"

                    "${CI_VENV}/bin/python" --version

                    "${CI_VENV}/bin/python" -m pip install --upgrade pip

                    echo "Installing CI tooling..."

                    "${CI_VENV}/bin/python" -m pip install \
                        pytest \
                        pytest-cov \
                        build \
                        coverage

                    echo "Verifying pytest..."

                    "${CI_VENV}/bin/python" -m pytest --version

                    echo "Verifying pytest-cov..."

                    "${CI_VENV}/bin/python" -m pytest --help \
                        | grep -- --cov

                    echo "Verifying Python build..."

                    "${CI_VENV}/bin/python" -m build --version

                    echo "======================================"
                    echo "PYTHON ENVIRONMENT READY"
                    echo "======================================"
                '''
            }
        }


        // =========================================================
        // CONFIGURE JFROG
        // =========================================================

        stage('Configure JFrog') {

            steps {

                withCredentials([

                    usernamePassword(
                        credentialsId: JFROG_USER_ID,
                        usernameVariable: 'JFROG_USER',
                        passwordVariable: 'JFROG_USER_PASSWORD'
                    ),

                    string(
                        credentialsId: JFROG_TOKEN_ID,
                        variable: 'JFROG_TOKEN'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "CONFIGURING JFROG"
                        echo "======================================"

                        jf config rm "${JFROG_SERVER_ID}" --quiet || true

                        jf config add "${JFROG_SERVER_ID}" \
                            --url="${JFROG_URL}" \
                            --user="${JFROG_USER}" \
                            --access-token="${JFROG_TOKEN}" \
                            --interactive=false \
                            --overwrite=true

                        jf config use "${JFROG_SERVER_ID}"

                        echo "JFrog configuration created."

                        echo "Server:"
                        jf config show "${JFROG_SERVER_ID}" \
                            --details=false || true

                        echo "======================================"
                        echo "JFROG CONFIGURED"
                        echo "======================================"
                    '''
                }
            }
        }


        // =========================================================
        // INSTALL DEPENDENCIES
        // =========================================================

        stage('Install Dependencies') {

            steps {

                withCredentials([

                    usernamePassword(
                        credentialsId: JFROG_USER_ID,
                        usernameVariable: 'JFROG_USER',
                        passwordVariable: 'JFROG_USER_PASSWORD'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "INSTALLING PYTHON DEPENDENCIES"
                        echo "======================================"

                        PYTHON="${WORKSPACE}/${CI_VENV}/bin/python"

                        PIP_CONFIG="${WORKSPACE}/${CI_VENV}/pip.conf"

                        cleanup_pip_config() {
                            rm -f "${PIP_CONFIG}"
                        }

                        trap cleanup_pip_config EXIT


                        cat > "${PIP_CONFIG}" <<EOF
[global]
index-url = https://${JFROG_USER}:${JFROG_USER_PASSWORD}@trialn4vk2g.jfrog.io/artifactory/${JFROG_DEPENDENCY_REPO}/simple
trusted-host = trialn4vk2g.jfrog.io
EOF


                        export PIP_CONFIG_FILE="${PIP_CONFIG}"


                        if [ -f requirements.txt ]; then

                            echo "Found requirements.txt"

                            "${PYTHON}" -m pip install \
                                -r requirements.txt

                        else

                            echo "No requirements.txt found."

                        fi


                        echo "======================================"
                        echo "DEPENDENCIES INSTALLED"
                        echo "======================================"
                    '''
                }
            }
        }


        // =========================================================
        // UNIT TESTS
        // =========================================================

        stage('Unit Tests') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "PYTHON UNIT TESTS"
                    echo "======================================"

                    PYTHON="${WORKSPACE}/${CI_VENV}/bin/python"

                    export PATH="${WORKSPACE}/${CI_VENV}/bin:${PATH}"

                    export PYTHONPATH="${WORKSPACE}:${PYTHONPATH:-}"


                    echo "Python:"
                    "${PYTHON}" --version


                    echo "Pytest:"
                    "${PYTHON}" -m pytest --version


                    if [ ! -d tests ]; then

                        echo "ERROR: tests directory not found."

                        exit 1

                    fi


                    mkdir -p test-results


                    "${PYTHON}" -m pytest \
                        -v \
                        --junitxml=test-results/pytest-results.xml \
                        --cov=. \
                        --cov-report=xml \
                        --cov-report=term \
                        --cov-fail-under=0


                    echo "======================================"
                    echo "UNIT TESTS PASSED"
                    echo "======================================"
                '''
            }

            post {

                always {

                    junit(
                        allowEmptyResults: true,
                        testResults:
                            'test-results/pytest-results.xml'
                    )

                    archiveArtifacts(
                        artifacts: 'coverage.xml',
                        allowEmptyArchive: true,
                        fingerprint: true
                    )
                }
            }
        }


        // =========================================================
        // BUILD PACKAGE
        // =========================================================

        stage('Build Python Package') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "BUILDING PYTHON PACKAGE"
                    echo "======================================"

                    rm -rf dist build *.egg-info

                    "${WORKSPACE}/${CI_VENV}/bin/python" \
                        -m build

                    echo "======================================"
                    echo "BUILD OUTPUT"
                    echo "======================================"

                    ls -lah dist


                    if ! ls dist/*.whl >/dev/null 2>&1; then

                        echo "ERROR: Python wheel was not generated."

                        exit 1

                    fi


                    echo "PACKAGE BUILD COMPLETED"
                '''
            }

            post {

                success {

                    archiveArtifacts(
                        artifacts: 'dist/*',
                        fingerprint: true
                    )
                }
            }
        }


        // =========================================================
        // READ PACKAGE VERSION
        // =========================================================

        stage('Read Package Version') {

            steps {

                script {

                    def wheel = sh(
                        script:
                            'ls dist/*.whl | head -1',
                        returnStdout: true
                    ).trim()


                    def fileName =
                        wheel.tokenize('/').last()


                    /*
                     * Example:
                     *
                     * python_sonar_test-1.0.0-py3-none-any.whl
                     */

                    def matcher =
                        fileName =~ /^(.+)-([0-9][^-]*)-(.+)\.whl$/


                    if (!matcher.matches()) {

                        error(
                            "Unable to determine Python package version from ${fileName}"
                        )
                    }


                    env.PYTHON_PACKAGE_NAME =
                        matcher[0][1]

                    env.PYTHON_PACKAGE_VERSION =
                        matcher[0][2]


                    echo """
====================================================
PYTHON PACKAGE
====================================================

Package       : ${env.PYTHON_PACKAGE_NAME}
Version       : ${env.PYTHON_PACKAGE_VERSION}

Wheel         : ${fileName}

JFrog Project : ${env.JFROG_PROJECT}
Repository    : ${env.ARTIFACTORY_REPO}

Artifact Path :
${env.JFROG_ARTIFACT_PATH}

====================================================
"""
                }
            }
        }


        // =========================================================
        // SONARQUBE
        // =========================================================

        stage('SonarQube Analysis') {

            steps {

                script {

                    def scannerHome =
                        tool 'SonarQubeLocal'


                    withSonarQubeEnv(SONAR_SERVER) {

                        withCredentials([

                            string(
                                credentialsId: SONAR_TOKEN_ID,
                                variable: 'SONAR_TOKEN'
                            )
                        ]) {

                            sh '''
                                set -e

                                echo "======================================"
                                echo "SONARQUBE ANALYSIS"
                                echo "======================================"

                                "${SONAR_SCANNER_HOME}/bin/sonar-scanner" \
                                    -Dsonar.projectKey="${SONAR_PROJECT_KEY}" \
                                    -Dsonar.projectName="${SONAR_PROJECT_NAME}" \
                                    -Dsonar.projectVersion="${PYTHON_PACKAGE_VERSION}" \
                                    -Dsonar.sources=. \
                                    -Dsonar.sourceEncoding=UTF-8 \
                                    -Dsonar.token="${SONAR_TOKEN}" \
                                    -Dsonar.exclusions="**/.venv/**,**/.ci-venv/**,**/venv/**,**/__pycache__/**,**/.pytest_cache/**,**/tests/**,**/dist/**,**/build/**,**/*.egg-info/**"

                                echo "======================================"
                                echo "SONARQUBE SCAN COMPLETED"
                                echo "======================================"
                            '''
                        }
                    }
                }
            }
        }


        // =========================================================
        // QUALITY GATE
        // =========================================================

        stage('SonarQube Quality Gate') {

            steps {

                timeout(
                    time: 10,
                    unit: 'MINUTES'
                ) {

                    script {

                        def qg =
                            waitForQualityGate(
                                abortPipeline: false
                            )


                        echo "Quality Gate: ${qg.status}"


                        if (
                            params.ENVIRONMENT == 'PROD' &&
                            qg.status != 'OK'
                        ) {

                            error(
                                "Quality Gate FAILED in PROD."
                            )
                        }


                        if (
                            params.ENVIRONMENT != 'PROD' &&
                            qg.status != 'OK'
                        ) {

                            echo """
Quality Gate failed.

Environment is ${params.ENVIRONMENT}.

Non-PROD pipeline will continue.
"""
                        }
                    }
                }
            }
        }


        // =========================================================
        // CREATE / UPDATE JFROG PROJECT + REPOSITORY
        // =========================================================

        stage('Create/Update Artifactory Repository') {

            steps {

                withCredentials([

                    string(
                        credentialsId: JFROG_TOKEN_ID,
                        variable: 'JFROG_TOKEN'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "======================================="
                        echo "ARTIFACTORY PROJECT / REPOSITORY"
                        echo "======================================="


                        /*
                         * =================================================
                         * CREATE ARTIFACTORY PROJECT
                         * =================================================
                         */

                        cat > project.json <<EOF
{
    "project_key": "${JFROG_PROJECT}",
    "display_name": "${PROJECT_NAME}",
    "description": "Python project managed by Jenkins v2",
    "admin_privileges": {
        "manage_members": true,
        "manage_resources": true,
        "index_resources": true,
        "manage_remote_repository": true,
        "create_remote_repository": true,
        "delete_remote_repository": true,
        "create_local_repository": true,
        "delete_local_repository": true,
        "create_virtual_repository": true,
        "delete_virtual_repository": true
    }
}
EOF


                        PROJECT_RESPONSE=$(curl \
                            --silent \
                            --show-error \
                            --write-out "\\n%{http_code}" \
                            --request POST \
                            --url "${JFROG_PLATFORM_URL}/access/api/v1/projects" \
                            --header "accept: application/json" \
                            --header "content-type: application/json" \
                            --header "Authorization: Bearer ${JFROG_TOKEN}" \
                            --data @project.json)


                        PROJECT_HTTP_CODE=$(echo "${PROJECT_RESPONSE}" | tail -n 1)

                        PROJECT_BODY=$(echo "${PROJECT_RESPONSE}" | sed '$d')


                        echo "Project HTTP Status: ${PROJECT_HTTP_CODE}"


                        if [
                            "${PROJECT_HTTP_CODE}" -ge 200
                        ] && [
                            "${PROJECT_HTTP_CODE}" -lt 300
                        ]; then

                            echo "PROJECT CREATED SUCCESSFULLY"


                        elif [
                            "${PROJECT_HTTP_CODE}" = "409"
                        ]; then

                            echo "PROJECT ALREADY EXISTS"

                        else

                            echo "FAILED TO CREATE PROJECT"

                            echo "${PROJECT_BODY}"

                            exit 1

                        fi


                        /*
                         * =================================================
                         * CREATE / UPDATE LOCAL PYTHON REPOSITORY
                         * =================================================
                         */

                        cat > repo.json <<EOF
{
    "rclass": "local",
    "packageType": "pypi",
    "environments": [
        "${ENVIRONMENT}"
    ],
    "xrayIndex": true
}
EOF


                        echo "Repository:"
                        echo "${ARTIFACTORY_REPO}"


                        jf rt curl \
                            -XPUT \
                            -H "Content-Type: application/json" \
                            "/api/repositories/${ARTIFACTORY_REPO}" \
                            -d @repo.json


                        /*
                         * =================================================
                         * SHARE REPOSITORY WITH ARTIFACTORY PROJECT
                         * =================================================
                         */

                        SHARE_RESPONSE=$(curl \
                            --silent \
                            --show-error \
                            --write-out "\\n%{http_code}" \
                            --request PUT \
                            --url "${JFROG_PLATFORM_URL}/access/api/v1/projects/_/share/repositories/${ARTIFACTORY_REPO}/${JFROG_PROJECT}?readOnly=false" \
                            --header "accept: application/json" \
                            --header "Authorization: Bearer ${JFROG_TOKEN}" \
                            || true)


                        SHARE_HTTP_CODE=$(echo "${SHARE_RESPONSE}" | tail -n 1)


                        echo "Share HTTP Status: ${SHARE_HTTP_CODE}"


                        if [
                            "${SHARE_HTTP_CODE}" = "204"
                        ]; then

                            echo "REPOSITORY SHARED SUCCESSFULLY"

                        elif [
                            "${SHARE_HTTP_CODE}" = "409"
                        ]; then

                            echo "REPOSITORY ALREADY SHARED"

                        else

                            echo "Repository sharing returned:"
                            echo "${SHARE_RESPONSE}"

                            echo "Continuing."

                        fi


                        echo "======================================="
                        echo "ARTIFACTORY CONFIGURATION COMPLETED"
                        echo "======================================="
                    '''
                }
            }
        }


        // =========================================================
        // PUBLISH ARTIFACT + BUILD INFO
        // =========================================================

        stage('Publish Artifact + Build Provenance') {

            steps {

                withCredentials([

                    string(
                        credentialsId: JFROG_TOKEN_ID,
                        variable: 'JFROG_TOKEN'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "======================================="
                        echo "JFROG ARTIFACT PUBLICATION"
                        echo "======================================="


                        jf c rm artifactory --quiet || true


                        jf c add artifactory \
                            --url="${JFROG_URL}" \
                            --access-token="${JFROG_TOKEN}" \
                            --interactive=false \
                            --overwrite=true


                        jf c use artifactory


                        /*
                         * -------------------------------------------------
                         * Collect environment
                         *
                         * IMPORTANT:
                         * jf rt build-collect-env accepts exactly:
                         *
                         * build-name build-number
                         *
                         * No server-id argument.
                         * -------------------------------------------------
                         */

                        jf rt build-collect-env \
                            "${JFROG_BUILD_NAME}" \
                            "${JFROG_BUILD_NUMBER}" \
                            --project="${JFROG_PROJECT}"


                        /*
                         * -------------------------------------------------
                         * Upload wheel
                         * -------------------------------------------------
                         */

                        for file in dist/*.whl; do

                            FILE_NAME=$(basename "${file}")

                            MODULE_NAME="${PYTHON_PACKAGE_NAME}"


                            echo "Uploading:"
                            echo "${file}"


                            jf rt upload \
                                "${file}" \
                                "${ARTIFACTORY_REPO}/${PROJECT_FOLDER}/${BUILD_NUMBER}/${FILE_NAME}" \
                                --flat=true \
                                --build-name="${JFROG_BUILD_NAME}" \
                                --build-number="${JFROG_BUILD_NUMBER}" \
                                --project="${JFROG_PROJECT}" \
                                --module="${MODULE_NAME}" \
                                --detailed-summary

                        done


                        /*
                         * -------------------------------------------------
                         * Upload source distribution
                         * -------------------------------------------------
                         */

                        for file in dist/*.tar.gz; do

                            if [ -f "${file}" ]; then

                                FILE_NAME=$(basename "${file}")

                                MODULE_NAME="${PYTHON_PACKAGE_NAME}"


                                jf rt upload \
                                    "${file}" \
                                    "${ARTIFACTORY_REPO}/${PROJECT_FOLDER}/${BUILD_NUMBER}/${FILE_NAME}" \
                                    --flat=true \
                                    --build-name="${JFROG_BUILD_NAME}" \
                                    --build-number="${JFROG_BUILD_NUMBER}" \
                                    --project="${JFROG_PROJECT}" \
                                    --module="${MODULE_NAME}" \
                                    --detailed-summary

                            fi

                        done


                        /*
                         * -------------------------------------------------
                         * Publish Build Info
                         * -------------------------------------------------
                         */

                        jf rt build-publish \
                            "${JFROG_BUILD_NAME}" \
                            "${JFROG_BUILD_NUMBER}" \
                            --project="${JFROG_PROJECT}" \
                            --collect-env \
                            --env-exclude "*password*;*secret*;*key*;*token*;*auth*" \
                            --collect-git-info \
                            --dot-git-path .


                        echo "======================================="
                        echo "BUILD INFO PUBLISHED"
                        echo "======================================="


                        jf bs \
                            "${JFROG_BUILD_NAME}" \
                            "${JFROG_BUILD_NUMBER}" \
                            --project="${JFROG_PROJECT}" \
                            --format=json \
                            > xray-result.json || true


                        echo "JFROG BUILD PUBLICATION COMPLETED"
                    '''
                }
            }

            post {

                always {

                    archiveArtifacts(
                        artifacts: 'xray-result.json',
                        allowEmptyArchive: true,
                        fingerprint: true
                    )
                }
            }
        }


        // =========================================================
        // XRAY
        // =========================================================

        stage('Xray Scan') {

            steps {

                withCredentials([

                    string(
                        credentialsId: JFROG_TOKEN_ID,
                        variable: 'JFROG_TOKEN'
                    )
                ]) {

                    script {

                        sh '''
                            set -e

                            echo "======================================="
                            echo "XRAY BUILD SCAN"
                            echo "======================================="


                            jf c rm artifactory --quiet || true


                            jf c add artifactory \
                                --url="${JFROG_URL}" \
                                --access-token="${JFROG_TOKEN}" \
                                --interactive=false \
                                --overwrite=true


                            jf c use artifactory


                            jf bs \
                                "${JFROG_BUILD_NAME}" \
                                "${JFROG_BUILD_NUMBER}" \
                                --project="${JFROG_PROJECT}" \
                                --format=json \
                                > xray-result.json


                            echo "======================================="
                            echo "XRAY RESULT"
                            echo "======================================="

                            cat xray-result.json || true
                        '''


                        def critical = sh(
                            script: '''
                                grep -o '"severity"[[:space:]]*:[[:space:]]*"Critical"' \
                                    xray-result.json 2>/dev/null \
                                    | wc -l
                            ''',
                            returnStdout: true
                        ).trim().toInteger()


                        def high = sh(
                            script: '''
                                grep -o '"severity"[[:space:]]*:[[:space:]]*"High"' \
                                    xray-result.json 2>/dev/null \
                                    | wc -l
                            ''',
                            returnStdout: true
                        ).trim().toInteger()


                        def medium = sh(
                            script: '''
                                grep -o '"severity"[[:space:]]*:[[:space:]]*"Medium"' \
                                    xray-result.json 2>/dev/null \
                                    | wc -l
                            ''',
                            returnStdout: true
                        ).trim().toInteger()


                        def low = sh(
                            script: '''
                                grep -o '"severity"[[:space:]]*:[[:space:]]*"Low"' \
                                    xray-result.json 2>/dev/null \
                                    | wc -l
                            ''',
                            returnStdout: true
                        ).trim().toInteger()


                        env.XRAY_CRITICAL = "${critical}"
                        env.XRAY_HIGH = "${high}"
                        env.XRAY_MEDIUM = "${medium}"
                        env.XRAY_LOW = "${low}"


                        env.XRAY_STATUS =
                            (
                                critical > 0 ||
                                high > 0
                            )
                            ? 'FAILED'
                            : 'PASSED'


                        echo """
=======================================
XRAY SUMMARY
=======================================

Project : ${PROJECT_NAME}
Build   : ${BUILD_NUMBER}

Critical: ${critical}
High    : ${high}
Medium  : ${medium}
Low     : ${low}

Status  : ${env.XRAY_STATUS}

=======================================
"""


                        if (
                            critical > 0 ||
                            high > 0
                        ) {

                            if (params.ENVIRONMENT == 'PROD') {

                                error(
                                    "PROD BLOCKED: Xray Critical/High findings detected."
                                )

                            } else {

                                echo """
NON-PROD ENVIRONMENT

Critical/High findings detected.

DEV deployment is allowed to continue.
"""
                            }
                        }
                    }
                }
            }

            post {

                always {

                    archiveArtifacts(
                        artifacts: 'xray-result.json',
                        allowEmptyArchive: true,
                        fingerprint: true
                    )
                }
            }
        }


        // =========================================================
        // GENERATE SBOM
        // =========================================================

        stage('Generate SBOM') {

            steps {

                sh '''
                    set -e

                    echo "======================================="
                    echo "GENERATING PYTHON SBOM"
                    echo "======================================="


                    rm -rf sbom

                    mkdir -p sbom


                    PYTHON="${WORKSPACE}/${CI_VENV}/bin/python"


                    /*
                     * Generate a simple CycloneDX-style SBOM
                     * from installed Python packages.
                     *
                     * We avoid requiring another external tool.
                     */

                    "${PYTHON}" -m pip list \
                        --format=json \
                        > sbom/pip-packages.json


                    "${PYTHON}" - <<'PY'
import json
import uuid
from pathlib import Path

packages = json.loads(
    Path("sbom/pip-packages.json").read_text()
)

components = []

for package in packages:

    name = package.get("name", "")
    version = package.get("version", "")

    if not name:
        continue

    components.append({
        "type": "library",
        "name": name,
        "version": version,
        "purl":
            f"pkg:pypi/{name.lower()}@{version}"
    })


bom = {
    "bomFormat": "CycloneDX",
    "specVersion": "1.6",
    "serialNumber":
        f"urn:uuid:{uuid.uuid4()}",
    "version": 1,
    "metadata": {
        "component": {
            "type": "application",
            "name": "${PROJECT_NAME}",
            "version": "${PYTHON_PACKAGE_VERSION}"
        }
    },
    "components": components
}


Path("sbom/cyclonedx-merged.json").write_text(
    json.dumps(bom, indent=2)
)

print("CycloneDX SBOM generated.")
PY


                    echo "SBOM:"
                    ls -lah sbom
                '''
            }
        }


        // =========================================================
        // PUBLISH SBOM
        // =========================================================

        stage('Publish SBOM') {

            steps {

                withCredentials([

                    string(
                        credentialsId: JFROG_TOKEN_ID,
                        variable: 'JFROG_TOKEN'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "======================================="
                        echo "UPLOADING SBOM TO JFROG"
                        echo "======================================="


                        jf c rm artifactory --quiet || true


                        jf c add artifactory \
                            --url="${JFROG_URL}" \
                            --access-token="${JFROG_TOKEN}" \
                            --interactive=false \
                            --overwrite=true


                        jf c use artifactory


                        jf rt upload \
                            sbom/cyclonedx-merged.json \
                            "${ARTIFACTORY_REPO}/${PROJECT_FOLDER}/${BUILD_NUMBER}/sbom/" \
                            --flat=true \
                            --build-name="${JFROG_BUILD_NAME}" \
                            --build-number="${JFROG_BUILD_NUMBER}" \
                            --project="${JFROG_PROJECT}"


                        echo "SBOM uploaded successfully."
                    '''
                }
            }

            post {

                always {

                    archiveArtifacts(
                        artifacts: 'sbom/**',
                        allowEmptyArchive: true,
                        fingerprint: true
                    )
                }
            }
        }


        // =========================================================
        // FINAL RELEASE
        // =========================================================

        stage('Create Release Bundle + Promotion') {

            when {

                expression {
                    params.IS_FINAL_RUN == 'true'
                }
            }

            steps {

                withCredentials([

                    string(
                        credentialsId: JFROG_TOKEN_ID,
                        variable: 'JFROG_TOKEN'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "======================================="
                        echo "CREATING RELEASE BUNDLE"
                        echo "======================================="


                        jf c rm artifactory --quiet || true


                        jf c add artifactory \
                            --url="${JFROG_URL}" \
                            --access-token="${JFROG_TOKEN}" \
                            --interactive=false \
                            --overwrite=true


                        jf c use artifactory


                        RB_NAME="${PROJECT_FOLDER}-rb"

                        RB_VERSION="${BUILD_NUMBER}"


                        echo "Release Bundle:"
                        echo "${RB_NAME}/${RB_VERSION}"


                        jf rbc \
                            "${RB_NAME}" \
                            "${RB_VERSION}" \
                            --build-name="${JFROG_BUILD_NAME}" \
                            --build-number="${BUILD_NUMBER}" \
                            --project="${JFROG_PROJECT}" \
                            --sync


                        jf rbp \
                            "${RB_NAME}" \
                            "${RB_VERSION}" \
                            "${ENVIRONMENT}" \
                            --project="${JFROG_PROJECT}"


                        echo "======================================="
                        echo "RELEASE BUNDLE COMPLETED"
                        echo "======================================="
                    '''
                }
            }
        }
    }


    // =============================================================
    // POST
    // =============================================================

    post {

        success {

            script {

                def recipients = [
                    params.TO_EMAIL,
                    params.MANAGER_EMAIL,
                    params.PRIMARY_APPROVER_EMAIL
                ]
                .findAll {
                    it?.trim()
                }
                .join(',')


                if (recipients?.trim()) {

                    mail(
                        to: recipients,
                        cc: params.CC_EMAIL ?: '',
                        subject:
                            "PIPELINE SUCCESS - ${env.PROJECT_NAME}",
                        mimeType: 'text/html',
                        body: """
<h2 style="color:green;">
PIPELINE SUCCESS
</h2>

<p>
<b>Project:</b>
${env.PROJECT_NAME}
</p>

<p>
<b>Project URL:</b>
${params.PROJECT_URL}
</p>

<p>
<b>Environment:</b>
${params.ENVIRONMENT}
</p>

<p>
<b>Build:</b>
${BUILD_NUMBER}
</p>

<p>
<b>JFrog Project:</b>
${env.JFROG_PROJECT}
</p>

<p>
<b>JFrog Repository:</b>
${env.ARTIFACTORY_REPO}
</p>

<p>
<b>Artifact Path:</b>
${env.JFROG_ARTIFACT_PATH}
</p>

<p>
<b>Xray Status:</b>
${env.XRAY_STATUS ?: 'NOT EXECUTED'}
</p>

<p>
<a href="${BUILD_URL}">
Open Jenkins Build
</a>
</p>
"""
                    )
                }
            }
        }


        failure {

            script {

                def recipients = [
                    params.TO_EMAIL,
                    params.MANAGER_EMAIL,
                    params.PRIMARY_APPROVER_EMAIL
                ]
                .findAll {
                    it?.trim()
                }
                .join(',')


                if (recipients?.trim()) {

                    mail(
                        to: recipients,
                        cc: params.CC_EMAIL ?: '',
                        subject:
                            "PIPELINE FAILED - ${env.PROJECT_NAME ?: 'Python Project'}",
                        mimeType: 'text/html',
                        body: """
<h2 style="color:red;">
PIPELINE FAILED
</h2>

<p>
<b>Project:</b>
${env.PROJECT_NAME ?: 'Unknown'}
</p>

<p>
<b>Project URL:</b>
${params.PROJECT_URL}
</p>

<p>
<b>Environment:</b>
${params.ENVIRONMENT}
</p>

<p>
<b>Build:</b>
${BUILD_NUMBER}
</p>

<p>
<b>JFrog Repository:</b>
${env.ARTIFACTORY_REPO ?: 'Not created'}
</p>

<p>
<b>Xray Status:</b>
${env.XRAY_STATUS ?: 'NOT EXECUTED'}
</p>

<p>
Please check the Jenkins console for the failing stage.
</p>

<p>
<a href="${BUILD_URL}">
Open Jenkins Build
</a>
</p>
"""
                    )
                }
            }
        }


        aborted {

            script {

                def recipients = [
                    params.TO_EMAIL,
                    params.MANAGER_EMAIL,
                    params.PRIMARY_APPROVER_EMAIL
                ]
                .findAll {
                    it?.trim()
                }
                .join(',')


                if (recipients?.trim()) {

                    mail(
                        to: recipients,
                        cc: params.CC_EMAIL ?: '',
                        subject:
                            "PIPELINE ABORTED - ${env.PROJECT_NAME ?: 'Python Project'}",
                        mimeType: 'text/html',
                        body: """
<h2 style="color:orange;">
PIPELINE ABORTED
</h2>

<p>
<b>Project:</b>
${env.PROJECT_NAME ?: 'Unknown'}
</p>

<p>
<b>Environment:</b>
${params.ENVIRONMENT}
</p>

<p>
<b>Build:</b>
${BUILD_NUMBER}
</p>

<p>
Pipeline was stopped or timed out.
</p>

<p>
<a href="${BUILD_URL}">
Open Jenkins Build
</a>
</p>
"""
                    )
                }
            }
        }


        always {

            sh '''
                rm -rf .ci-venv || true
                rm -rf __pycache__ || true
                rm -rf .pytest_cache || true
                rm -rf build || true
                rm -rf *.egg-info || true
                rm -f project.json repo.json || true
            '''
        }
    }
}