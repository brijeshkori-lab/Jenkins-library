pipeline {

    agent any

    environment {

        // =========================================================
        // JFROG
        // =========================================================

        JFROG_URL = 'https://trialn4vk2g.jfrog.io'

        JFROG_SERVER = 'python-server'

        JFROG_PROJECT = 'python'

        JFROG_VIRTUAL_REPO = 'python-virtual'

        JFROG_LOCAL_REPO = 'python-local'

        JFROG_REMOTE_REPO = 'python-remote'


        // =========================================================
        // PYTHON
        // =========================================================

        CI_VENV = '.ci-venv'


        // =========================================================
        // JFROG BUILD INFO
        // =========================================================

        JFROG_CLI_BUILD_NUMBER = "${BUILD_NUMBER}"
    }


    stages {


        // =========================================================
        // 1. VALIDATE PARAMETERS
        // =========================================================

        stage('Validate Parameters') {

            steps {

                script {

                    if (!params.PROJECT_URL?.trim()) {

                        error(
                            'PROJECT_URL is required.'
                        )
                    }


                    if (!params.PYTHON_VERSION?.trim()) {

                        error(
                            'PYTHON_VERSION is required.'
                        )
                    }


                    if (!params.ENVIRONMENT?.trim()) {

                        error(
                            'ENVIRONMENT is required.'
                        )
                    }


                    if (
                        params.ENVIRONMENT == 'PROD' &&
                        params.IS_FINAL_RUN != 'true'
                    ) {

                        error("""
====================================================
PRODUCTION DEPLOYMENT BLOCKED
====================================================

PROD requires:

ENVIRONMENT  = PROD
IS_FINAL_RUN = true

====================================================
""")
                    }


                    if (
                        params.ENVIRONMENT == 'DEV' &&
                        params.IS_FINAL_RUN == 'true'
                    ) {

                        error("""
====================================================
INVALID FINAL RUN
====================================================

IS_FINAL_RUN=true is only valid for PROD.

====================================================
""")
                    }


                    echo """
====================================================
PYTHON PIPELINE PARAMETERS
====================================================

Project URL   : ${params.PROJECT_URL}
Python        : ${params.PYTHON_VERSION}
Environment   : ${params.ENVIRONMENT}
Final Run     : ${params.IS_FINAL_RUN}

JFrog Project : ${env.JFROG_PROJECT}
JFrog Resolve : ${env.JFROG_VIRTUAL_REPO}
JFrog Deploy  : ${env.JFROG_LOCAL_REPO}

Jenkins Build : ${BUILD_NUMBER}

====================================================
"""
                }
            }
        }


        // =========================================================
        // 2. INITIALIZE PROJECT
        // =========================================================

        stage('Initialize') {

            steps {

                script {

                    def cleanUrl =
                        params.PROJECT_URL
                            .trim()
                            .replaceAll(/\/$/, '')
                            .replaceAll(/\.git$/, '')


                    def projectName =
                        cleanUrl.tokenize('/')[-1]


                    if (!projectName?.trim()) {

                        error(
                            "Unable to derive project name from PROJECT_URL."
                        )
                    }


                    /*
                     * Remove characters that could cause problems
                     * in JFrog paths / build names.
                     */

                    projectName =
                        projectName
                            .toLowerCase()
                            .replaceAll(/[^a-z0-9._-]/, '-')


                    env.PROJECT_NAME = projectName

                    env.JFROG_CLI_BUILD_NAME = projectName


                    echo """
====================================================
PROJECT INITIALIZATION
====================================================

Project URL       : ${params.PROJECT_URL}

Derived Project   : ${env.PROJECT_NAME}

Python Version    : ${params.PYTHON_VERSION}

JFrog Project     : ${env.JFROG_PROJECT}

JFrog Build Name  : ${env.JFROG_CLI_BUILD_NAME}

Jenkins Build ID  : ${BUILD_NUMBER}

====================================================
"""
                }
            }
        }


        // =========================================================
        // 3. PROD APPROVAL
        // =========================================================

        stage('Final Run Approval') {

            when {

                expression {

                    params.ENVIRONMENT == 'PROD' &&
                    params.IS_FINAL_RUN == 'true'
                }
            }


            steps {

                script {

                    if (!params.PRIMARY_APPROVER_EMAIL?.trim()) {

                        error(
                            'PRIMARY_APPROVER_EMAIL is required for PROD.'
                        )
                    }


                    if (!params.MANAGER_EMAIL?.trim()) {

                        error(
                            'MANAGER_EMAIL is required for PROD.'
                        )
                    }


                    echo """
====================================================
PRODUCTION APPROVAL
====================================================

Project       : ${env.PROJECT_NAME}
Build         : ${BUILD_NUMBER}
Python        : ${params.PYTHON_VERSION}
Environment   : PROD

====================================================
"""


                    mail(

                        to: params.PRIMARY_APPROVER_EMAIL,

                        subject:
                            "PROD APPROVAL REQUIRED - ${env.PROJECT_NAME} #${BUILD_NUMBER}",

                        mimeType: 'text/html',

                        body: """

                            <h2>Python Production Approval Required</h2>

                            <p>
                                <b>Project:</b>
                                ${env.PROJECT_NAME}
                            </p>

                            <p>
                                <b>Build:</b>
                                ${BUILD_NUMBER}
                            </p>

                            <p>
                                <b>Python:</b>
                                ${params.PYTHON_VERSION}
                            </p>

                            <p>
                                <b>Environment:</b>
                                PROD
                            </p>

                            <p>
                                <a href="${BUILD_URL}">
                                    Open Jenkins Build
                                </a>
                            </p>

                            <p>
                                Please review and approve the release
                                from Jenkins.
                            </p>
                        """
                    )


                    def approver = input(

                        message: """

====================================================
PRODUCTION RELEASE APPROVAL
====================================================

Project:
${env.PROJECT_NAME}

Build:
${BUILD_NUMBER}

Python:
${params.PYTHON_VERSION}

Environment:
PROD

Approve this production release?

====================================================

""",

                        ok: 'APPROVE PROD RELEASE',

                        submitter: 'admin',

                        submitterParameter: 'APPROVER'
                    )


                    env.APPROVED_BY = approver


                    mail(

                        to: params.MANAGER_EMAIL,

                        subject:
                            "PROD RELEASE APPROVED - ${env.PROJECT_NAME} #${BUILD_NUMBER}",

                        mimeType: 'text/html',

                        body: """

                            <h2>Python Production Release Approved</h2>

                            <p>
                                <b>Project:</b>
                                ${env.PROJECT_NAME}
                            </p>

                            <p>
                                <b>Build:</b>
                                ${BUILD_NUMBER}
                            </p>

                            <p>
                                <b>Python:</b>
                                ${params.PYTHON_VERSION}
                            </p>

                            <p>
                                <b>Approved By:</b>
                                ${approver}
                            </p>

                            <p>
                                <a href="${BUILD_URL}">
                                    Open Jenkins Build
                                </a>
                            </p>
                        """
                    )
                }
            }
        }


        // =========================================================
        // 4. CLEAN WORKSPACE
        // =========================================================

        stage('Clean Workspace') {

            steps {

                deleteDir()
            }
        }


        // =========================================================
        // 5. CHECKOUT APPLICATION
        // =========================================================

        stage('Checkout') {

            steps {

                git(

                    url: params.PROJECT_URL,

                    branch: 'main'
                )
            }
        }


        // =========================================================
        // 6. PYTHON ENVIRONMENT
        // =========================================================

        stage('Setup Python Environment') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "PYTHON ENVIRONMENT"
                    echo "======================================"


                    PYTHON_BIN="python${PYTHON_VERSION}"


                    if [ "${PYTHON_VERSION}" = "3.13" ]; then
                        PYTHON_BIN="python3"
                    fi


                    echo "Requested Python:"
                    echo "${PYTHON_VERSION}"


                    if ! command -v "${PYTHON_BIN}" >/dev/null 2>&1; then

                        echo "ERROR: ${PYTHON_BIN} is not installed on Jenkins agent."

                        echo "Available Python versions:"

                        compgen -c | grep '^python' | sort -u || true

                        exit 1
                    fi


                    echo "Using:"
                    command -v "${PYTHON_BIN}"

                    "${PYTHON_BIN}" --version


                    rm -rf "${CI_VENV}"


                    "${PYTHON_BIN}" -m venv "${CI_VENV}"


                    "${CI_VENV}/bin/python" --version


                    "${CI_VENV}/bin/python" -m pip install \
                        --upgrade pip


                    echo "Installing CI tooling..."


                    "${CI_VENV}/bin/python" -m pip install \
                        pytest \
                        pytest-cov \
                        build \
                        coverage


                    echo "Verifying pytest..."

                    "${CI_VENV}/bin/python" \
                        -m pytest --version


                    echo "Verifying pytest-cov..."

                    "${CI_VENV}/bin/python" \
                        -m pytest --help | grep -- '--cov'


                    echo "Verifying build..."

                    "${CI_VENV}/bin/python" \
                        -m build --version


                    echo "======================================"
                    echo "PYTHON ENVIRONMENT READY"
                    echo "======================================"
                '''
            }
        }


        // =========================================================
        // 7. CONFIGURE JFROG
        // =========================================================

        stage('Configure JFrog') {

            steps {

                withCredentials([

                    string(
                        credentialsId: 'jfrog-user',
                        variable: 'JFROG_USER'
                    ),

                    string(
                        credentialsId: 'jfrog-token',
                        variable: 'JFROG_TOKEN'
                    )

                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "CONFIGURING JFROG"
                        echo "======================================"


                        jf config rm "${JFROG_SERVER}" \
                            --quiet || true


                        jf config add "${JFROG_SERVER}" \
                            --url="${JFROG_URL}" \
                            --user="${JFROG_USER}" \
                            --access-token="${JFROG_TOKEN}" \
                            --interactive=false \
                            --overwrite=true


                        jf config use "${JFROG_SERVER}"


                        echo "Testing JFrog..."

                        jf rt ping


                        echo "JFrog connection successful."


                        echo "======================================"
                    '''
                }
            }
        }


        // =========================================================
        // 8. INSTALL DEPENDENCIES FROM JFROG
        // =========================================================

        stage('Install Dependencies') {

            steps {

                withCredentials([

                    string(
                        credentialsId: 'jfrog-user',
                        variable: 'JFROG_USER'
                    ),

                    string(
                        credentialsId: 'jfrog-token',
                        variable: 'JFROG_TOKEN'
                    )

                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "INSTALLING PYTHON DEPENDENCIES"
                        echo "======================================"


                        PYTHON="${CI_VENV}/bin/python"


                        PIP_CONFIG="${WORKSPACE}/${CI_VENV}/pip.conf"


                        cleanup_pip_config() {

                            rm -f "${PIP_CONFIG}"

                        }


                        trap cleanup_pip_config EXIT


                        cat > "${PIP_CONFIG}" <<EOF
[global]
index-url = https://${JFROG_USER}:${JFROG_TOKEN}@${JFROG_URL}/artifactory/${JFROG_VIRTUAL_REPO}/simple
EOF


                        export PIP_CONFIG_FILE="${PIP_CONFIG}"


                        if [ -f requirements.txt ]; then

                            echo "Found requirements.txt"

                            "${PYTHON}" -m pip install \
                                -r requirements.txt


                        elif [ -f pyproject.toml ]; then

                            echo "Found pyproject.toml"

                            "${PYTHON}" -m pip install \
                                .


                        else

                            echo "No requirements.txt or pyproject.toml found."

                            echo "Continuing without application dependencies."

                        fi


                        echo "======================================"
                        echo "DEPENDENCIES INSTALLED"
                        echo "======================================"
                    '''
                }
            }
        }


        // =========================================================
        // 9. UNIT TESTS
        // =========================================================

        stage('Unit Tests') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "PYTHON UNIT TESTS"
                    echo "======================================"


                    PYTHON="${CI_VENV}/bin/python"


                    export PATH="${WORKSPACE}/${CI_VENV}/bin:${PATH}"

                    export PYTHONPATH="${WORKSPACE}:${PYTHONPATH:-}"


                    "${PYTHON}" --version

                    "${PYTHON}" -m pytest --version


                    if [ ! -d tests ]; then

                        echo "ERROR: tests directory not found."

                        exit 1

                    fi


                    mkdir -p test-results


                    "${PYTHON}" -m pytest \
                        -v \
                        --junitxml=test-results/pytest-results.xml \
                        --cov=. \
                        --cov-report=xml \
                        --cov-report=term \
                        --cov-fail-under=0


                    echo "======================================"
                    echo "UNIT TESTS PASSED"
                    echo "======================================"
                '''
            }


            post {

                always {

                    junit(

                        allowEmptyResults: true,

                        testResults:
                            'test-results/pytest-results.xml'
                    )


                    archiveArtifacts(

                        artifacts:
                            'coverage.xml',

                        allowEmptyArchive: true,

                        fingerprint: true
                    )
                }
            }
        }


        // =========================================================
        // 10. BUILD PYTHON PACKAGE
        // =========================================================

        stage('Build Python Package') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "BUILDING PYTHON PACKAGE"
                    echo "======================================"


                    PYTHON="${CI_VENV}/bin/python"


                    rm -rf dist build *.egg-info


                    "${PYTHON}" -m build


                    echo "======================================"
                    echo "BUILD OUTPUT"
                    echo "======================================"


                    ls -lah dist


                    if ! ls dist/*.whl >/dev/null 2>&1; then

                        echo "ERROR: wheel was not generated."

                        exit 1

                    fi


                    if ! ls dist/*.tar.gz >/dev/null 2>&1; then

                        echo "ERROR: source distribution was not generated."

                        exit 1

                    fi


                    echo "======================================"
                    echo "PACKAGE BUILD COMPLETED"
                    echo "======================================"
                '''
            }
        }


        // =========================================================
        // 11. READ PACKAGE VERSION
        // =========================================================

        stage('Read Package Version') {

            steps {

                script {

                    def wheelFile = sh(

                        script:
                            "ls dist/*.whl | head -1",

                        returnStdout: true
                    ).trim()


                    def wheelName =
                        wheelFile.tokenize('/')[-1]


                    def wheelParts =
                        wheelName.tokenize('-')


                    if (wheelParts.size() < 2) {

                        error(
                            "Unable to determine package version from ${wheelName}"
                        )
                    }


                    env.PYTHON_PACKAGE_FILE =
                        wheelFile

                    env.PYTHON_PACKAGE_NAME =
                        wheelParts[0]

                    env.PYTHON_PACKAGE_VERSION =
                        wheelParts[1]


                    /*
                     * Build-specific artifact path.
                     *
                     * Example:
                     *
                     * python-local/
                     *   python-app-template/
                     *     1.0.0/
                     *       42/
                     *         package.whl
                     */

                    env.JFROG_ARTIFACT_PATH =
                        "${JFROG_LOCAL_REPO}/${PROJECT_NAME}/${PYTHON_PACKAGE_VERSION}/${BUILD_NUMBER}/"


                    echo """
====================================================
PYTHON PACKAGE
====================================================

Package       : ${env.PYTHON_PACKAGE_NAME}
Version       : ${env.PYTHON_PACKAGE_VERSION}

Wheel         : ${env.PYTHON_PACKAGE_FILE}

Jenkins Build : ${BUILD_NUMBER}

JFrog Path    : ${env.JFROG_ARTIFACT_PATH}

====================================================
"""
                }
            }
        }


        // =========================================================
        // 12. COLLECT JFROG BUILD INFORMATION
        // =========================================================

        stage('Collect JFrog Build Information') {

            steps {

                withCredentials([

                    string(
                        credentialsId: 'jfrog-user',
                        variable: 'JFROG_USER'
                    ),

                    string(
                        credentialsId: 'jfrog-token',
                        variable: 'JFROG_TOKEN'
                    )

                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "COLLECTING JFROG BUILD INFORMATION"
                        echo "======================================"


                        jf rt build-collect-env \
                            "${JFROG_CLI_BUILD_NAME}" \
                            "${JFROG_CLI_BUILD_NUMBER}"


                        echo "Build information collected."


                        echo "======================================"
                    '''
                }
            }
        }


        // =========================================================
        // 13. PUBLISH PACKAGE
        // =========================================================

        stage('Publish Package to JFrog') {

            steps {

                withCredentials([

                    string(
                        credentialsId: 'jfrog-user',
                        variable: 'JFROG_USER'
                    ),

                    string(
                        credentialsId: 'jfrog-token',
                        variable: 'JFROG_TOKEN'
                    )

                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "PUBLISHING PYTHON PACKAGE"
                        echo "======================================"


                        echo "JFrog Project:"
                        echo "${JFROG_PROJECT}"

                        echo "Project:"
                        echo "${PROJECT_NAME}"

                        echo "Package:"
                        echo "${PYTHON_PACKAGE_NAME}"

                        echo "Version:"
                        echo "${PYTHON_PACKAGE_VERSION}"

                        echo "Build:"
                        echo "${BUILD_NUMBER}"

                        echo "Repository:"
                        echo "${JFROG_LOCAL_REPO}"


                        # -------------------------------------------------
                        # Wheel
                        # -------------------------------------------------

                        jf rt upload \
                            "dist/*.whl" \
                            "${JFROG_ARTIFACT_PATH}" \
                            --flat=true


                        # -------------------------------------------------
                        # Source Distribution
                        # -------------------------------------------------

                        jf rt upload \
                            "dist/*.tar.gz" \
                            "${JFROG_ARTIFACT_PATH}" \
                            --flat=true


                        # -------------------------------------------------
                        # Publish Build Info
                        # -------------------------------------------------

                        jf rt build-publish \
                            "${JFROG_CLI_BUILD_NAME}" \
                            "${JFROG_CLI_BUILD_NUMBER}"


                        echo "======================================"
                        echo "PACKAGE PUBLISHED"
                        echo "======================================"
                    '''
                }
            }
        }


        // =========================================================
        // 14. XRAY
        // =========================================================

        stage('Xray Scan') {

            steps {

                withCredentials([

                    string(
                        credentialsId: 'jfrog-user',
                        variable: 'JFROG_USER'
                    ),

                    string(
                        credentialsId: 'jfrog-token',
                        variable: 'JFROG_TOKEN'
                    )

                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "JFROG XRAY SCAN"
                        echo "======================================"


                        echo "Build:"
                        echo "${JFROG_CLI_BUILD_NAME}/${JFROG_CLI_BUILD_NUMBER}"


                        jf rt build-scan \
                            "${JFROG_CLI_BUILD_NAME}" \
                            "${JFROG_CLI_BUILD_NUMBER}"


                        echo "======================================"
                        echo "XRAY SCAN COMPLETED"
                        echo "======================================"
                    '''
                }
            }
        }


        // =========================================================
        // 15. GENERATE SBOM
        // =========================================================

        stage('Generate SBOM') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "GENERATING PYTHON SBOM"
                    echo "======================================"


                    PYTHON="${CI_VENV}/bin/python"


                    "${PYTHON}" -m pip install \
                        cyclonedx-bom


                    "${CI_VENV}/bin/cyclonedx-py" \
                        environment \
                        --output-format json \
                        --output-file cyclonedx-sbom.json


                    ls -lah cyclonedx-sbom.json


                    echo "SBOM generated."


                    echo "======================================"
                '''
            }


            post {

                always {

                    archiveArtifacts(

                        artifacts:
                            'cyclonedx-sbom.json',

                        allowEmptyArchive: true,

                        fingerprint: true
                    )
                }
            }
        }


        // =========================================================
        // 16. PUBLISH SBOM
        // =========================================================

        stage('Publish SBOM') {

            steps {

                withCredentials([

                    string(
                        credentialsId: 'jfrog-user',
                        variable: 'JFROG_USER'
                    ),

                    string(
                        credentialsId: 'jfrog-token',
                        variable: 'JFROG_TOKEN'
                    )

                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "PUBLISHING SBOM"
                        echo "======================================"


                        jf rt upload \
                            "cyclonedx-sbom.json" \
                            "${JFROG_ARTIFACT_PATH}sbom/" \
                            --server-id="${JFROG_SERVER}" \
                            --flat=true


                        echo "SBOM published."


                        echo "======================================"
                    '''
                }
            }
        }


        // =========================================================
        // 17. PRODUCTION RELEASE
        // =========================================================

        stage('Production Release') {

            when {

                expression {

                    params.ENVIRONMENT == 'PROD' &&
                    params.IS_FINAL_RUN == 'true'
                }
            }


            steps {

                script {

                    echo """
====================================================
PRODUCTION RELEASE
====================================================

JFrog Project : ${env.JFROG_PROJECT}

Project       : ${env.PROJECT_NAME}

Package       : ${env.PYTHON_PACKAGE_NAME}

Version       : ${env.PYTHON_PACKAGE_VERSION}

Build         : ${BUILD_NUMBER}

Python        : ${params.PYTHON_VERSION}

Approved By   : ${env.APPROVED_BY}

Artifact Path:
${env.JFROG_ARTIFACT_PATH}

====================================================
"""


                    echo "Production release completed."
                }
            }
        }
    }


    // =============================================================
    // POST
    // =============================================================

    post {

        success {

            echo """
====================================================
PYTHON PIPELINE SUCCESS
====================================================

Project       : ${env.PROJECT_NAME}

Build         : ${BUILD_NUMBER}

Python        : ${params.PYTHON_VERSION}

Environment   : ${params.ENVIRONMENT}

Package       : ${env.PYTHON_PACKAGE_NAME}

Version       : ${env.PYTHON_PACKAGE_VERSION}

JFrog Project : ${env.JFROG_PROJECT}

Artifact Path :
${env.JFROG_ARTIFACT_PATH}

Tests         : PASSED
JFrog         : PUBLISHED
Xray          : COMPLETED
SBOM          : GENERATED

====================================================
"""
        }


        failure {

            echo """
====================================================
PYTHON PIPELINE FAILED
====================================================

Project     : ${env.PROJECT_NAME}
Build       : ${BUILD_NUMBER}
Environment : ${params.ENVIRONMENT}

Check the failed stage and Jenkins console.

====================================================
"""
        }


        aborted {

            echo """
====================================================
PYTHON PIPELINE ABORTED
====================================================

Project : ${env.PROJECT_NAME}
Build   : ${BUILD_NUMBER}

====================================================
"""
        }


        always {

            sh '''
                rm -rf .ci-venv || true
                rm -rf .venv || true
                rm -rf __pycache__ || true
                rm -rf .pytest_cache || true
                rm -rf build || true
                rm -rf *.egg-info || true
            '''
        }
    }
}