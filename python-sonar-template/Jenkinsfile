pipeline {

    agent any


    // =========================================================
    // PARAMETERS
    // =========================================================

    parameters {

        // -----------------------------------------------------
        // GIT
        // -----------------------------------------------------

        string(
            name: 'GIT_URL',
            defaultValue: '',
            description: 'Git URL of the Python application'
        )

        string(
            name: 'GIT_BRANCH',
            defaultValue: 'main',
            description: 'Git branch to build'
        )


        // -----------------------------------------------------
        // PYTHON
        // -----------------------------------------------------

        choice(
            name: 'PYTHON_VERSION',
            choices: [
                'python3'
            ],
            description: 'Python executable available on the Jenkins agent'
        )


        // -----------------------------------------------------
        // ENVIRONMENT
        // -----------------------------------------------------

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'DEV',
                'PROD'
            ],
            description: 'Target environment'
        )

        choice(
            name: 'IS_FINAL_RUN',
            choices: [
                'false',
                'true'
            ],
            description: 'Must be true for PROD execution'
        )


        // -----------------------------------------------------
        // PYTHON BUILD
        // -----------------------------------------------------

        string(
            name: 'REQUIREMENTS_FILE',
            defaultValue: 'requirements.txt',
            description: 'Python dependency file'
        )

        string(
            name: 'TEST_COMMAND',
            defaultValue: 'pytest -v',
            description: 'Python test command'
        )


        // -----------------------------------------------------
        // SONARQUBE
        // -----------------------------------------------------

        string(
            name: 'SONAR_PROJECT_KEY',
            defaultValue: 'python-app',
            description: 'SonarQube project key'
        )

        string(
            name: 'SONAR_PROJECT_NAME',
            defaultValue: 'python-app',
            description: 'SonarQube project name'
        )


        // -----------------------------------------------------
        // PROD APPROVAL
        // -----------------------------------------------------

        string(
            name: 'PRIMARY_APPROVER_EMAIL',
            defaultValue: '',
            description: 'Email address of the PROD approver'
        )

        string(
            name: 'MANAGER_EMAIL',
            defaultValue: '',
            description: 'Manager email for PROD notification'
        )
    }


    // =========================================================
    // ENVIRONMENT
    // =========================================================

    environment {

        // -----------------------------------------------------
        // SONARQUBE
        // -----------------------------------------------------

        SONAR_SERVER = 'SonarQubeLocal'

        SONAR_TOKEN_CREDENTIAL = 'sonar-token'


        // -----------------------------------------------------
        // JFROG
        // -----------------------------------------------------

        JFROG_URL = 'https://trialn4vk2g.jfrog.io'

        JFROG_USER_CREDENTIAL = 'jfrog-user'

        JFROG_TOKEN_CREDENTIAL = 'jfrog-token'

        JFROG_VIRTUAL_REPO = 'python-virtual'

        JFROG_LOCAL_REPO = 'python-local'


        // -----------------------------------------------------
        // PYTHON
        // -----------------------------------------------------

        VENV_DIR = '.venv'

        PACKAGE_DIR = 'dist'
    }


    // =========================================================
    // STAGES
    // =========================================================

    stages {


        // =====================================================
        // 1. VALIDATE PARAMETERS
        // =====================================================

        stage('Validate Parameters') {

            steps {

                script {

                    // -------------------------------------------------
                    // Required parameter validation
                    // -------------------------------------------------

                    if (!params.GIT_URL?.trim()) {

                        error(
                            'GIT_URL is required.'
                        )
                    }


                    if (!params.SONAR_PROJECT_KEY?.trim()) {

                        error(
                            'SONAR_PROJECT_KEY is required.'
                        )
                    }


                    if (!params.SONAR_PROJECT_NAME?.trim()) {

                        error(
                            'SONAR_PROJECT_NAME is required.'
                        )
                    }


                    // -------------------------------------------------
                    // PROD SAFETY CHECK
                    // -------------------------------------------------

                    if (
                        params.ENVIRONMENT == 'PROD' &&
                        params.IS_FINAL_RUN != 'true'
                    ) {

                        error("""
====================================================
PRODUCTION EXECUTION BLOCKED
====================================================

Environment : PROD
Final Run   : ${params.IS_FINAL_RUN}

PROD execution requires:

ENVIRONMENT = PROD
IS_FINAL_RUN = true

Please correct the parameters and run again.

====================================================
""")
                    }


                    // -------------------------------------------------
                    // FINAL RUN SAFETY CHECK
                    // -------------------------------------------------

                    if (
                        params.IS_FINAL_RUN == 'true' &&
                        params.ENVIRONMENT != 'PROD'
                    ) {

                        error("""
====================================================
FINAL RUN BLOCKED
====================================================

IS_FINAL_RUN = true

But environment is:

${params.ENVIRONMENT}

Final Run is allowed only for PROD.

====================================================
""")
                    }


                    // -------------------------------------------------
                    // Pipeline summary
                    // -------------------------------------------------

                    echo """
====================================================
PYTHON + SONARQUBE PIPELINE
====================================================

Git URL              : ${params.GIT_URL}
Git Branch           : ${params.GIT_BRANCH}

Python Version       : ${params.PYTHON_VERSION}

Environment          : ${params.ENVIRONMENT}
Final Run            : ${params.IS_FINAL_RUN}

Requirements File    : ${params.REQUIREMENTS_FILE}
Test Command         : ${params.TEST_COMMAND}

Sonar Project Key    : ${params.SONAR_PROJECT_KEY}
Sonar Project Name   : ${params.SONAR_PROJECT_NAME}

JFrog URL            : ${env.JFROG_URL}
JFrog Resolve Repo   : ${env.JFROG_VIRTUAL_REPO}
JFrog Deploy Repo    : ${env.JFROG_LOCAL_REPO}

====================================================
"""
                }
            }
        }


        // =====================================================
        // 2. CHECK PYTHON
        // =====================================================

        stage('Check Python') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "CHECKING PYTHON"
                    echo "======================================"

                    echo "Python executable:"
                    command -v "${PYTHON_VERSION}"

                    echo "Python version:"
                    "${PYTHON_VERSION}" --version

                    echo "Pip version:"
                    "${PYTHON_VERSION}" -m pip --version

                    echo "======================================"
                    echo "PYTHON CHECK PASSED"
                    echo "======================================"
                '''
            }
        }


        // =====================================================
        // 3. CHECK JFROG
        // =====================================================

        stage('Check JFrog') {

            steps {

                withCredentials([

                    string(
                        credentialsId: env.JFROG_USER_CREDENTIAL,
                        variable: 'JFROG_USER'
                    ),

                    string(
                        credentialsId: env.JFROG_TOKEN_CREDENTIAL,
                        variable: 'JFROG_TOKEN'
                    )

                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "CONFIGURING JFROG"
                        echo "======================================"

                        jf c rm artifactory || true

                        jf c add artifactory \
                            --url="${JFROG_URL}" \
                            --user="${JFROG_USER}" \
                            --access-token="${JFROG_TOKEN}" \
                            --interactive=false \
                            --overwrite=true

                        echo "Testing JFrog connection..."

                        jf rt ping

                        echo "JFrog connection successful."

                        echo "======================================"
                        echo "JFROG REPOSITORIES"
                        echo "======================================"

                        echo "Resolve repository : ${JFROG_VIRTUAL_REPO}"
                        echo "Deploy repository  : ${JFROG_LOCAL_REPO}"

                        echo "======================================"
                        echo "JFROG CHECK PASSED"
                        echo "======================================"
                    '''
                }
            }
        }


        // =====================================================
        // 4. CHECKOUT
        // =====================================================

        stage('Checkout') {

            steps {

                deleteDir()

                git(
                    url: params.GIT_URL,
                    branch: params.GIT_BRANCH
                )
            }
        }


        // =====================================================
        // 5. CREATE PYTHON VIRTUAL ENVIRONMENT
        // =====================================================

        stage('Create Virtual Environment') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "CREATING PYTHON VIRTUAL ENVIRONMENT"
                    echo "======================================"

                    "${PYTHON_VERSION}" -m venv "${VENV_DIR}"

                    . "${VENV_DIR}/bin/activate"

                    echo "Python version:"
                    python --version

                    echo "Upgrading build tooling..."

                    python -m pip install \
                        --upgrade \
                        pip \
                        setuptools \
                        wheel \
                        build

                    echo "======================================"
                    echo "VIRTUAL ENVIRONMENT CREATED"
                    echo "======================================"
                '''
            }
        }


        // =====================================================
        // 6. INSTALL DEPENDENCIES FROM JFROG
        // =====================================================

        stage('Install Dependencies from JFrog') {

            steps {

                withCredentials([

                    string(
                        credentialsId: env.JFROG_USER_CREDENTIAL,
                        variable: 'JFROG_USER'
                    ),

                    string(
                        credentialsId: env.JFROG_TOKEN_CREDENTIAL,
                        variable: 'JFROG_TOKEN'
                    )

                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "INSTALLING PYTHON DEPENDENCIES"
                        echo "======================================"

                        . "${VENV_DIR}/bin/activate"

                        if [ -f "${REQUIREMENTS_FILE}" ]; then

                            echo "Configuring JFrog Python repository..."

                            jf pip-config \
                                --server-id-resolve=artifactory \
                                --repo-resolve="${JFROG_VIRTUAL_REPO}"

                            echo "Installing dependencies from:"
                            echo "${JFROG_VIRTUAL_REPO}"

                            jf pip install \
                                -r "${REQUIREMENTS_FILE}"

                        else

                            echo "No ${REQUIREMENTS_FILE} found."

                            echo "Skipping dependency installation."

                        fi

                        echo "======================================"
                        echo "DEPENDENCY INSTALLATION COMPLETED"
                        echo "======================================"
                    '''
                }
            }
        }


        // =====================================================
        // 7. TEST
        // =====================================================

        stage('Test') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "RUNNING PYTHON TESTS"
                    echo "======================================"

                    . "${VENV_DIR}/bin/activate"

                    echo "Python version:"
                    python --version

                    export PYTHONPATH="${WORKSPACE}:${PYTHONPATH:-}"

                    echo "PYTHONPATH=${PYTHONPATH}"

                    echo "======================================"
                    echo "TEST COMMAND"
                    echo "======================================"

                    echo "${TEST_COMMAND}"

                    ${TEST_COMMAND}

                    echo "======================================"
                    echo "PYTHON TESTS PASSED"
                    echo "======================================"
                '''
            }
        }


        // =====================================================
        // 8. SONARQUBE SCAN
        // =====================================================

        stage('SonarQube Scan') {

            steps {

                script {

                    /*
                     * SonarScanner installation configured in Jenkins:
                     *
                     * SonarQubeLocal
                     *
                     * SonarQube server:
                     * SonarQubeLocal
                     *
                     * Jenkins credential:
                     * sonar-token
                     */

                    def scannerHome = tool 'SonarQubeLocal'


                    withCredentials([

                        string(
                            credentialsId: 'sonar-token',
                            variable: 'SONAR_TOKEN'
                        )

                    ]) {

                        withSonarQubeEnv('SonarQubeLocal') {

                            withEnv([

                                "SONAR_SCANNER_HOME=${scannerHome}",

                                "SONAR_PROJECT_KEY=${params.SONAR_PROJECT_KEY}",

                                "SONAR_PROJECT_NAME=${params.SONAR_PROJECT_NAME}"

                            ]) {

                                sh '''
                                    set -e

                                    echo "======================================"
                                    echo "SONARQUBE ANALYSIS"
                                    echo "======================================"

                                    echo "SonarQube URL:"
                                    echo "${SONAR_HOST_URL}"

                                    echo "SonarQube Project Key:"
                                    echo "${SONAR_PROJECT_KEY}"

                                    echo "SonarQube Project Name:"
                                    echo "${SONAR_PROJECT_NAME}"

                                    echo "Scanner:"
                                    "${SONAR_SCANNER_HOME}/bin/sonar-scanner" --version

                                    echo "======================================"
                                    echo "STARTING SONARQUBE SCAN"
                                    echo "======================================"

                                    "${SONAR_SCANNER_HOME}/bin/sonar-scanner" \
                                        -Dsonar.projectKey="${SONAR_PROJECT_KEY}" \
                                        -Dsonar.projectName="${SONAR_PROJECT_NAME}" \
                                        -Dsonar.projectVersion="${BUILD_NUMBER}" \
                                        -Dsonar.sources=. \
                                        -Dsonar.sourceEncoding=UTF-8 \
                                        -Dsonar.exclusions="**/.venv/**,**/venv/**,**/__pycache__/**,**/.pytest_cache/**,**/tests/**,**/dist/**,**/build/**"

                                    echo "======================================"
                                    echo "SONARQUBE SCAN COMPLETED"
                                    echo "======================================"
                                '''
                            }
                        }
                    }
                }
            }
        }


        // =====================================================
        // 9. QUALITY GATE
        // =====================================================

        stage('SonarQube Quality Gate') {

            steps {

                timeout(
                    time: 10,
                    unit: 'MINUTES'
                ) {

                    script {

                        echo "======================================"
                        echo "WAITING FOR SONARQUBE QUALITY GATE"
                        echo "======================================"

                        def qualityGate = waitForQualityGate(
                            abortPipeline: false
                        )

                        echo "Quality Gate Status:"
                        echo qualityGate.status


                        if (qualityGate.status != 'OK') {

                            error(
                                "SonarQube Quality Gate FAILED: ${qualityGate.status}"
                            )
                        }


                        echo "======================================"
                        echo "SONARQUBE QUALITY GATE PASSED"
                        echo "======================================"
                    }
                }
            }
        }


        // =====================================================
        // 10. BUILD PYTHON PACKAGE
        // =====================================================

        stage('Build Python Package') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "BUILDING PYTHON PACKAGE"
                    echo "======================================"

                    . "${VENV_DIR}/bin/activate"

                    rm -rf "${PACKAGE_DIR}"

                    python -m build

                    echo "======================================"
                    echo "BUILD OUTPUT"
                    echo "======================================"

                    ls -lah "${PACKAGE_DIR}"

                    echo "======================================"
                    echo "PYTHON PACKAGE BUILD COMPLETED"
                    echo "======================================"
                '''
            }
        }


        // =====================================================
        // 11. READ PACKAGE VERSION
        // =====================================================

        stage('Read Package Version') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "PACKAGE INFORMATION"
                    echo "======================================"

                    . "${VENV_DIR}/bin/activate"

                    python -c "
import glob
import os

files = glob.glob('dist/*.whl')

if not files:
    raise SystemExit('ERROR: No wheel found in dist/')

for file in files:
    print('Package:', os.path.basename(file))
"
                '''
            }
        }


        // =====================================================
        // 12. PROD APPROVAL
        // =====================================================

        stage('PROD Approval') {

            when {

                expression {

                    params.ENVIRONMENT == 'PROD' &&
                    params.IS_FINAL_RUN == 'true'
                }
            }


            steps {

                script {

                    // -------------------------------------------------
                    // Validate approval parameters
                    // -------------------------------------------------

                    if (!params.PRIMARY_APPROVER_EMAIL?.trim()) {

                        error(
                            'PRIMARY_APPROVER_EMAIL is required for PROD.'
                        )
                    }


                    if (!params.MANAGER_EMAIL?.trim()) {

                        error(
                            'MANAGER_EMAIL is required for PROD.'
                        )
                    }


                    echo """
====================================================
PRODUCTION APPROVAL REQUIRED
====================================================

Project       : ${params.SONAR_PROJECT_NAME}
Build         : ${BUILD_NUMBER}
Environment   : PROD

Jenkins Build:
${BUILD_URL}

====================================================
"""


                    // -------------------------------------------------
                    // SEND APPROVAL EMAIL
                    // -------------------------------------------------

                    mail(

                        to: params.PRIMARY_APPROVER_EMAIL,

                        subject:
                            "PROD APPROVAL REQUIRED - ${params.SONAR_PROJECT_NAME}",

                        mimeType: 'text/html',

                        body: """

                            <h2>PRODUCTION APPROVAL REQUIRED</h2>

                            <p>
                                <b>Project:</b>
                                ${params.SONAR_PROJECT_NAME}
                            </p>

                            <p>
                                <b>Build:</b>
                                ${BUILD_NUMBER}
                            </p>

                            <p>
                                <b>Environment:</b>
                                PROD
                            </p>

                            <p>
                                <b>SonarQube Project:</b>
                                ${params.SONAR_PROJECT_KEY}
                            </p>

                            <p>
                                <b>Jenkins Build:</b>
                                <a href="${BUILD_URL}">
                                    ${BUILD_URL}
                                </a>
                            </p>

                            <p>
                                Please review the build and approve
                                the production execution in Jenkins.
                            </p>

                        """
                    )


                    // -------------------------------------------------
                    // JENKINS MANUAL APPROVAL
                    // -------------------------------------------------

                    def approver = input(

                        message: """

====================================================
PRODUCTION APPROVAL REQUIRED
====================================================

Project     : ${params.SONAR_PROJECT_NAME}
Build       : ${BUILD_NUMBER}
Environment : PROD

Please verify:

1. Build completed successfully
2. Unit tests passed
3. SonarQube scan passed
4. SonarQube Quality Gate passed

Only approve if the build is ready for PROD.

====================================================

""",

                        ok: 'APPROVE PROD',

                        submitter:
                            'primary-approver,admin,devops-admin',

                        submitterParameter:
                            'APPROVER'
                    )


                    env.APPROVED_BY = approver


                    echo """
====================================================
PRODUCTION APPROVED
====================================================

Approved By : ${approver}
Build       : ${BUILD_NUMBER}

====================================================
"""


                    // -------------------------------------------------
                    // MANAGER NOTIFICATION
                    // -------------------------------------------------

                    mail(

                        to: params.MANAGER_EMAIL,

                        subject:
                            "PROD BUILD APPROVED - ${params.SONAR_PROJECT_NAME}",

                        mimeType: 'text/html',

                        body: """

                            <h2>PRODUCTION BUILD APPROVED</h2>

                            <p>
                                <b>Project:</b>
                                ${params.SONAR_PROJECT_NAME}
                            </p>

                            <p>
                                <b>Build:</b>
                                ${BUILD_NUMBER}
                            </p>

                            <p>
                                <b>Environment:</b>
                                PROD
                            </p>

                            <p>
                                <b>Approved By:</b>
                                ${approver}
                            </p>

                            <p>
                                <b>Jenkins Build:</b>
                                <a href="${BUILD_URL}">
                                    ${BUILD_URL}
                                </a>
                            </p>

                        """
                    )
                }
            }
        }


        // =====================================================
        // 13. PUBLISH TO JFROG
        // =====================================================

        stage('Publish Package to JFrog') {

            when {

                expression {

                    params.ENVIRONMENT == 'PROD' &&
                    params.IS_FINAL_RUN == 'true'
                }
            }


            steps {

                withCredentials([

                    string(
                        credentialsId: env.JFROG_USER_CREDENTIAL,
                        variable: 'JFROG_USER'
                    ),

                    string(
                        credentialsId: env.JFROG_TOKEN_CREDENTIAL,
                        variable: 'JFROG_TOKEN'
                    )

                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "PUBLISHING PYTHON PACKAGE TO JFROG"
                        echo "======================================"

                        jf c rm artifactory || true

                        jf c add artifactory \
                            --url="${JFROG_URL}" \
                            --user="${JFROG_USER}" \
                            --access-token="${JFROG_TOKEN}" \
                            --interactive=false \
                            --overwrite=true

                        echo "Testing JFrog connection..."

                        jf rt ping


                        echo "======================================"
                        echo "UPLOADING WHEEL"
                        echo "======================================"

                        jf rt upload \
                            "${PACKAGE_DIR}/*.whl" \
                            "${JFROG_LOCAL_REPO}/" \
                            --flat=true


                        echo "======================================"
                        echo "UPLOADING SOURCE DISTRIBUTION"
                        echo "======================================"

                        if ls "${PACKAGE_DIR}"/*.tar.gz >/dev/null 2>&1; then

                            jf rt upload \
                                "${PACKAGE_DIR}/*.tar.gz" \
                                "${JFROG_LOCAL_REPO}/" \
                                --flat=true

                        else

                            echo "No .tar.gz found."
                            echo "Skipping source distribution."

                        fi


                        echo "======================================"
                        echo "JFROG PUBLISH COMPLETED"
                        echo "======================================"

                        echo "Repository: ${JFROG_LOCAL_REPO}"
                    '''
                }
            }
        }
    }


    // =========================================================
    // POST ACTIONS
    // =========================================================

    post {

        success {

            echo """
====================================================
PYTHON + SONARQUBE PIPELINE SUCCESS
====================================================

Project     : ${params.SONAR_PROJECT_NAME}
Environment : ${params.ENVIRONMENT}
Build       : ${BUILD_NUMBER}

====================================================
"""
        }


        failure {

            echo """
====================================================
PYTHON + SONARQUBE PIPELINE FAILED
====================================================

Project     : ${params.SONAR_PROJECT_NAME}
Environment : ${params.ENVIRONMENT}
Build       : ${BUILD_NUMBER}

Please check the failed stage and Jenkins console.

====================================================
"""
        }


        always {

            sh '''
                rm -rf .venv || true
                rm -rf __pycache__ || true
                rm -rf .pytest_cache || true
            '''
        }
    }
}