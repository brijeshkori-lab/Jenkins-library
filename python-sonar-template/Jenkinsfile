pipeline {

    agent any

    parameters {

        string(
            name: 'PROJECT_URL',
            defaultValue: '',
            description: 'Git URL of the Python application'
        )

        choice(
            name: 'PYTHON_VERSION',
            choices: [
                'python3.8',
                'python3.9',
                'python3.10',
                'python3.11',
                'python3.12'
            ],
            description: 'Python version'
        )

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'DEV',
                'PROD'
            ],
            description: 'Target environment'
        )

        string(
            name: 'SONAR_PROJECT_KEY',
            defaultValue: 'python-app',
            description: 'SonarQube project key'
        )

        string(
            name: 'SONAR_PROJECT_NAME',
            defaultValue: 'Python App',
            description: 'SonarQube project name'
        )
    }

    environment {

        SONAR_SERVER = 'SonarQube'
    }

    stages {

        stage('Validate Parameters') {

            steps {

                script {

                    if (!params.PROJECT_URL?.trim()) {
                        error 'PROJECT_URL is required'
                    }

                    if (!params.SONAR_PROJECT_KEY?.trim()) {
                        error 'SONAR_PROJECT_KEY is required'
                    }

                    if (!params.SONAR_PROJECT_NAME?.trim()) {
                        error 'SONAR_PROJECT_NAME is required'
                    }

                    echo """
========================================
Python Application Template
========================================

Project URL       : ${params.PROJECT_URL}
Python Version    : ${params.PYTHON_VERSION}
Environment       : ${params.ENVIRONMENT}
Sonar Project Key : ${params.SONAR_PROJECT_KEY}
Sonar Project Name: ${params.SONAR_PROJECT_NAME}

========================================
"""
                }
            }
        }

        stage('Checkout') {

            steps {

                deleteDir()

                git(
                    url: params.PROJECT_URL,
                    branch: 'main'
                )
            }
        }

        stage('Python Version') {

            steps {

                sh """
                    set -e

                    echo "Requested Python version:"
                    ${params.PYTHON_VERSION} --version
                """
            }
        }

        stage('Install Dependencies') {

            steps {

                sh """
                    set -e

                    ${params.PYTHON_VERSION} -m venv .venv

                    . .venv/bin/activate

                    python --version

                    python -m pip install --upgrade pip

                    if [ -f requirements.txt ]; then
                        pip install -r requirements.txt
                    else
                        echo "No requirements.txt found"
                    fi
                """
            }
        }

        stage('Unit Tests') {

            steps {

                sh """
                    set -e

                    . .venv/bin/activate

                    if [ -d tests ]; then

                        pip install pytest pytest-cov

                        pytest \
                            --junitxml=test-results.xml \
                            --cov=. \
                            --cov-report=xml

                    else

                        echo "No tests directory found"
                        echo "Skipping tests"
                    fi
                """
            }

            post {

                always {

                    junit(
                        allowEmptyResults: true,
                        testResults: 'test-results.xml'
                    )

                    archiveArtifacts(
                        artifacts: 'coverage.xml',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('SonarQube Analysis') {

            steps {

                withSonarQubeEnv("${SONAR_SERVER}") {

                    sh """
                        set -e

                        . .venv/bin/activate

                        pip install sonar-scanner-cli

                        sonar-scanner \
                            -Dsonar.projectKey=${params.SONAR_PROJECT_KEY} \
                            -Dsonar.projectName=${params.SONAR_PROJECT_NAME} \
                            -Dsonar.sources=. \
                            -Dsonar.python.version=${params.PYTHON_VERSION.replace('python3.', '3.')} \
                            -Dsonar.exclusions=.venv/**,**/__pycache__/**,tests/** \
                            -Dsonar.scm.disabled=true
                    """
                }
            }
        }

      stage('SonarQube Quality Gate') {

    steps {

        script {

            timeout(
                time: 10,
                unit: 'MINUTES'
            ) {

                def qualityGate = waitForQualityGate(
                    abortPipeline: false
                )

                echo "SonarQube Quality Gate: ${qualityGate.status}"

                if (
                    params.ENVIRONMENT == 'PROD' &&
                    qualityGate.status != 'OK'
                ) {

                    error(
                        "SonarQube Quality Gate FAILED in PROD"
                    )
                }

                if (
                    params.ENVIRONMENT != 'PROD' &&
                    qualityGate.status != 'OK'
                ) {

                    echo """
SonarQube Quality Gate failed.

Environment: ${params.ENVIRONMENT}

Pipeline continues because this is a non-PROD build.
"""
                }

                if (qualityGate.status == 'OK') {

                    echo """
========================================
SONARQUBE QUALITY GATE PASSED
========================================
"""
                }
            }
        }
    }
}

    post {

        success {

            echo """
========================================
PYTHON PIPELINE SUCCESS
========================================

Project     : ${params.PROJECT_URL}
Python      : ${params.PYTHON_VERSION}
Environment : ${params.ENVIRONMENT}
SonarQube   : ${params.SONAR_PROJECT_NAME}

========================================
"""
        }

        failure {

            echo """
========================================
PYTHON PIPELINE FAILED
========================================

Project     : ${params.PROJECT_URL}
Python      : ${params.PYTHON_VERSION}
Environment : ${params.ENVIRONMENT}

Check Jenkins logs for details.

========================================
"""
        }
    }
}