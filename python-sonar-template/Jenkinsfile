pipeline {

    agent any

    environment {

        // =========================================================
        // APPLICATION CONFIGURATION
        // =========================================================

        // Application URL is template-defined.
        // Change this when this template is used for another app.
        PROJECT_URL = 'https://github.com/brijeshkori-lab/python-app-template'

        GIT_BRANCH = 'main'


        // =========================================================
        // JFROG CLOUD
        // =========================================================

        JFROG_URL = 'https://trialn4vk2g.jfrog.io'

        JFROG_VIRTUAL_REPO = 'python-virtual'

        JFROG_LOCAL_REPO = 'python-local'

        JFROG_REMOTE_REPO = 'python-remote'

        JFROG_SERVER = 'python-server'


        // =========================================================
        // SONARQUBE
        // =========================================================

        SONAR_SERVER = 'SonarQubeLocal'


        // =========================================================
        // PYTHON
        // =========================================================

        PYTHON_COMMAND = 'python3'

        CI_VENV = '.ci-venv'


        // =========================================================
        // JFROG BUILD INFO
        // =========================================================

        JFROG_CLI_BUILD_NUMBER = "${BUILD_NUMBER}"
    }


    stages {


        // =========================================================
        // 1. PROD SAFETY GUARD
        // =========================================================

        stage('PROD Safety Guard') {

            steps {

                script {

                    echo """
====================================================
PRODUCTION SAFETY CHECK
====================================================

Environment : ${params.ENVIRONMENT}
Final Run   : ${params.IS_FINAL_RUN}

====================================================
"""


                    if (
                        params.ENVIRONMENT == 'PROD' &&
                        params.IS_FINAL_RUN != 'true'
                    ) {

                        error("""
====================================================
PRODUCTION DEPLOYMENT BLOCKED
====================================================

PROD deployments require:

ENVIRONMENT  = PROD
IS_FINAL_RUN = true

Current values:

ENVIRONMENT  = ${params.ENVIRONMENT}
IS_FINAL_RUN = ${params.IS_FINAL_RUN}

Please correct the parameters and rerun.

====================================================
""")
                    }


                    if (
                        params.ENVIRONMENT == 'DEV' &&
                        params.IS_FINAL_RUN == 'true'
                    ) {

                        error("""
====================================================
INVALID FINAL RUN
====================================================

IS_FINAL_RUN=true is only allowed for PROD.

Current environment:
${params.ENVIRONMENT}

====================================================
""")
                    }


                    echo "PROD SAFETY CHECK PASSED"
                }
            }
        }


        // =========================================================
        // 2. INITIALIZE
        // =========================================================

        stage('Initialize') {

            steps {

                script {

                    /*
                     * Derive project information from PROJECT_URL.
                     *
                     * Example:
                     *
                     * https://github.com/company/python-app-template
                     *
                     * becomes:
                     *
                     * python-app-template
                     */

                    def cleanUrl =
                        env.PROJECT_URL
                            .replaceAll(/\/$/, '')
                            .replaceAll(/\.git$/, '')


                    def projectName =
                        cleanUrl.tokenize('/')[-1]


                    if (!projectName?.trim()) {

                        error(
                            'Unable to derive project name from PROJECT_URL'
                        )
                    }


                    env.PROJECT_NAME = projectName

                    env.PROJECT_FOLDER = projectName

                    env.SONAR_PROJECT_KEY = projectName

                    env.SONAR_PROJECT_NAME = projectName

                    env.JFROG_CLI_BUILD_NAME = projectName


                    echo """
====================================================
PYTHON CI/CD INITIALIZATION
====================================================

Project URL        : ${env.PROJECT_URL}
Git Branch         : ${env.GIT_BRANCH}

Project Name       : ${env.PROJECT_NAME}
Project Folder     : ${env.PROJECT_FOLDER}

Sonar Project Key  : ${env.SONAR_PROJECT_KEY}
Sonar Project Name : ${env.SONAR_PROJECT_NAME}

JFrog URL          : ${env.JFROG_URL}
JFrog Resolve Repo : ${env.JFROG_VIRTUAL_REPO}
JFrog Deploy Repo  : ${env.JFROG_LOCAL_REPO}

JFrog Build Name   : ${env.JFROG_CLI_BUILD_NAME}
JFrog Build Number : ${env.JFROG_CLI_BUILD_NUMBER}

Environment        : ${params.ENVIRONMENT}
Final Run          : ${params.IS_FINAL_RUN}

====================================================
"""
                }
            }
        }


        // =========================================================
        // 3. FINAL RUN APPROVAL
        // =========================================================

        stage('Final Run Approval') {

            when {

                expression {

                    params.ENVIRONMENT == 'PROD' &&
                    params.IS_FINAL_RUN == 'true'
                }
            }


            steps {

                script {

                    echo """
====================================================
PRODUCTION APPROVAL REQUIRED
====================================================

Project     : ${env.PROJECT_NAME}
Environment : PROD
Build       : ${BUILD_NUMBER}

The pipeline requires production approval
before the final release.

====================================================
"""


                    if (!params.PRIMARY_APPROVER_EMAIL?.trim()) {

                        error(
                            'PRIMARY_APPROVER_EMAIL is required for PROD Final Run.'
                        )
                    }


                    if (!params.MANAGER_EMAIL?.trim()) {

                        error(
                            'MANAGER_EMAIL is required for PROD Final Run.'
                        )
                    }


                    // -------------------------------------------------
                    // Approval notification
                    // -------------------------------------------------

                    mail(

                        to: params.PRIMARY_APPROVER_EMAIL,

                        subject:
                            "PROD APPROVAL REQUIRED - ${env.PROJECT_NAME} #${BUILD_NUMBER}",

                        mimeType: 'text/html',

                        body: """

                            <h2>Production Approval Required</h2>

                            <p>
                                <b>Project:</b>
                                ${env.PROJECT_NAME}
                            </p>

                            <p>
                                <b>Build:</b>
                                ${BUILD_NUMBER}
                            </p>

                            <p>
                                <b>Environment:</b>
                                PROD
                            </p>

                            <p>
                                <b>SonarQube:</b>
                                Passed
                            </p>

                            <p>
                                Please review and approve the
                                production release in Jenkins.
                            </p>

                            <p>
                                <b>Jenkins Build:</b>
                                <a href="${BUILD_URL}">
                                    ${BUILD_URL}
                                </a>
                            </p>
                        """
                    )


                    // -------------------------------------------------
                    // Jenkins approval
                    // -------------------------------------------------

                    def approver = input(

                        message: """

====================================================
PRODUCTION RELEASE APPROVAL
====================================================

Project:
${env.PROJECT_NAME}

Build:
${BUILD_NUMBER}

Environment:
PROD

SonarQube:
PASSED

The next stages will publish the Python package
and perform the production release.

====================================================

""",

                        ok: 'APPROVE PROD RELEASE',

                        submitter: 'admin',

                        submitterParameter: 'APPROVER'
                    )


                    env.APPROVED_BY = approver


                    echo """
====================================================
PRODUCTION RELEASE APPROVED
====================================================

Approved By : ${approver}
Build       : ${BUILD_NUMBER}

====================================================
"""


                    mail(

                        to: params.MANAGER_EMAIL,

                        subject:
                            "PROD RELEASE APPROVED - ${env.PROJECT_NAME} #${BUILD_NUMBER}",

                        mimeType: 'text/html',

                        body: """

                            <h2>Production Release Approved</h2>

                            <p>
                                <b>Project:</b>
                                ${env.PROJECT_NAME}
                            </p>

                            <p>
                                <b>Build:</b>
                                ${BUILD_NUMBER}
                            </p>

                            <p>
                                <b>Approved By:</b>
                                ${approver}
                            </p>

                            <p>
                                <b>Environment:</b>
                                PROD
                            </p>

                            <p>
                                <b>Jenkins:</b>
                                <a href="${BUILD_URL}">
                                    ${BUILD_URL}
                                </a>
                            </p>
                        """
                    )
                }
            }
        }


        // =========================================================
        // 4. CLEAN WORKSPACE
        // =========================================================

        stage('Clean Workspace') {

            steps {

                deleteDir()
            }
        }


        // =========================================================
        // 5. CHECKOUT
        // =========================================================

        stage('Checkout') {

            steps {

                git(

                    url: env.PROJECT_URL,

                    branch: env.GIT_BRANCH
                )
            }
        }


        // =========================================================
        // 6. PYTHON ENVIRONMENT
        // =========================================================

       stage('Setup Python Environment') {

    steps {

        sh '''
            set -e

            echo "======================================"
            echo "PYTHON ENVIRONMENT"
            echo "======================================"

            command -v "${PYTHON_COMMAND}"

            "${PYTHON_COMMAND}" --version

            "${PYTHON_COMMAND}" -m pip --version

            rm -rf "${CI_VENV}"

            "${PYTHON_COMMAND}" -m venv "${CI_VENV}"

            "${CI_VENV}/bin/python" --version

            "${CI_VENV}/bin/python" -m pip install \
                --upgrade pip

            echo "Installing CI tooling..."

            "${CI_VENV}/bin/python" -m pip install \
                pytest \
                pytest-cov \
                build \
                coverage

            echo "Verifying pytest..."

            "${CI_VENV}/bin/python" -m pytest --version

            echo "Verifying pytest-cov..."

            "${CI_VENV}/bin/python" -m pytest --help | \
                grep -- '--cov'

            echo "Verifying Python build..."

            "${CI_VENV}/bin/python" -m build --version

            echo "======================================"
            echo "PYTHON ENVIRONMENT READY"
            echo "======================================"
        '''
    }
}


        // =========================================================
        // 7. CONFIGURE JFROG
        // =========================================================

        stage('Configure JFrog') {

            steps {

                withCredentials([

                    string(
                        credentialsId: 'jfrog-user',
                        variable: 'JFROG_USER'
                    ),

                    string(
                        credentialsId: 'jfrog-token',
                        variable: 'JFROG_TOKEN'
                    )

                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "CONFIGURING JFROG"
                        echo "======================================"

                        jf config rm "${JFROG_SERVER}" \
                            --quiet || true

                        jf config add "${JFROG_SERVER}" \
                            --url="${JFROG_URL}" \
                            --user="${JFROG_USER}" \
                            --access-token="${JFROG_TOKEN}" \
                            --interactive=false \
                            --overwrite=true

                        echo "Testing JFrog connection..."

                        jf rt ping \
                            --server-id="${JFROG_SERVER}"

                        echo "JFrog connection successful."

                        echo "======================================"
                    '''
                }
            }
        }


        // =========================================================
        // 8. INSTALL DEPENDENCIES FROM JFROG
        // =========================================================

        stage('Install Dependencies') {

            steps {

                withCredentials([

                    string(
                        credentialsId: 'jfrog-user',
                        variable: 'JFROG_USER'
                    ),

                    string(
                        credentialsId: 'jfrog-token',
                        variable: 'JFROG_TOKEN'
                    )

                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "INSTALLING PYTHON DEPENDENCIES"
                        echo "======================================"

                        PYTHON="${CI_VENV}/bin/python"

                        PIP_CONFIG="${WORKSPACE}/${CI_VENV}/pip.conf"

                        cleanup_pip_config() {
                            rm -f "${PIP_CONFIG}"
                        }

                        trap cleanup_pip_config EXIT


                        cat > "${PIP_CONFIG}" <<EOF
[global]
index-url = https://${JFROG_USER}:${JFROG_TOKEN}@${JFROG_URL}/artifactory/${JFROG_VIRTUAL_REPO}/simple
EOF

                        export PIP_CONFIG_FILE="${PIP_CONFIG}"


                        if [ -f requirements.txt ]; then

                            echo "Found requirements.txt"

                            "${PYTHON}" -m pip install \
                                -r requirements.txt


                        elif [ -f pyproject.toml ]; then

                            echo "Found pyproject.toml"

                            "${PYTHON}" -m pip install \
                                .


                        else

                            echo "No requirements.txt or pyproject.toml found."

                            echo "Continuing with project without external dependencies."

                        fi


                        echo "======================================"
                        echo "DEPENDENCIES INSTALLED"
                        echo "======================================"
                    '''
                }
            }
        }


        // =========================================================
        // 9. UNIT TESTS + COVERAGE
        // =========================================================

       stage('Unit Tests') {

    steps {

        sh '''
            set -e

            echo "======================================"
            echo "PYTHON UNIT TESTS"
            echo "======================================"

            PYTHON="${CI_VENV}/bin/python"

            export PATH="${WORKSPACE}/${CI_VENV}/bin:${PATH}"
            export PYTHONPATH="${WORKSPACE}:${PYTHONPATH:-}"

            echo "Python:"
            "${PYTHON}" --version

            echo "Pytest:"
            "${PYTHON}" -m pytest --version

            echo "Pytest-Cov:"
            "${PYTHON}" -m pytest_cov --version || true

            if [ ! -d tests ]; then

                echo "ERROR: tests directory not found."

                exit 1

            fi

            mkdir -p test-results

            "${PYTHON}" -m pytest \
                -v \
                --junitxml=test-results/pytest-results.xml \
                --cov=. \
                --cov-report=xml \
                --cov-report=term \
                --cov-fail-under=0

            echo "======================================"
            echo "UNIT TESTS PASSED"
            echo "======================================"
        '''
    }

    post {

        always {

            junit(
                allowEmptyResults: true,
                testResults: 'test-results/pytest-results.xml'
            )

            archiveArtifacts(
                artifacts: 'coverage.xml',
                allowEmptyArchive: true,
                fingerprint: true
            )
        }
    }
}


        // =========================================================
        // 10. BUILD PYTHON PACKAGE
        // =========================================================

        stage('Build Python Package') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "BUILDING PYTHON PACKAGE"
                    echo "======================================"

                    PYTHON="${CI_VENV}/bin/python"

                    rm -rf dist build *.egg-info

                    "${PYTHON}" -m build

                    echo "======================================"
                    echo "BUILD OUTPUT"
                    echo "======================================"

                    ls -lah dist

                    if ! ls dist/*.whl >/dev/null 2>&1; then

                        echo "ERROR: Python wheel was not generated."

                        exit 1

                    fi


                    if ! ls dist/*.tar.gz >/dev/null 2>&1; then

                        echo "ERROR: Python source distribution was not generated."

                        exit 1

                    fi


                    echo "Python package build completed."

                    echo "======================================"
                '''
            }
        }


        // =========================================================
        // 11. READ PACKAGE VERSION
        // =========================================================

        stage('Read Package Version') {

            steps {

                script {

                    def wheelFile = sh(

                        script:
                            "ls dist/*.whl | head -1",

                        returnStdout: true
                    ).trim()


                    def wheelName =
                        wheelFile.tokenize('/')[-1]


                    /*
                     * Python wheel format:
                     *
                     * name-version-python-abi-platform.whl
                     */

                    def wheelParts =
                        wheelName.tokenize('-')


                    if (wheelParts.size() < 2) {

                        error(
                            "Unable to determine package version from ${wheelName}"
                        )
                    }


                    env.PYTHON_PACKAGE_FILE =
                        wheelFile

                    env.PYTHON_PACKAGE_NAME =
                        wheelParts[0]

                    env.PYTHON_PACKAGE_VERSION =
                        wheelParts[1]


                    echo """
====================================================
PYTHON PACKAGE
====================================================

Package       : ${env.PYTHON_PACKAGE_NAME}
Version       : ${env.PYTHON_PACKAGE_VERSION}

Wheel         : ${env.PYTHON_PACKAGE_FILE}

====================================================
"""
                }
            }
        }


        // =========================================================
        // 12. SONARQUBE ANALYSIS
        // =========================================================

        stage('SonarQube Analysis') {

    steps {

        script {

            def scannerHome = tool(
                name: 'SonarQubeLocal'
            )

            withSonarQubeEnv('SonarQubeLocal') {

                withCredentials([
                    string(
                        credentialsId: 'sonar-token',
                        variable: 'SONAR_TOKEN'
                    )
                ]) {

                    withEnv([
                        "SCANNER_HOME=${scannerHome}"
                    ]) {

                        sh '''
                            set -e

                            echo "======================================"
                            echo "SONARQUBE ANALYSIS"
                            echo "======================================"

                            echo "Project:"
                            echo "${SONAR_PROJECT_NAME}"

                            echo "Project Key:"
                            echo "${SONAR_PROJECT_KEY}"

                            echo "Scanner:"
                            echo "${SCANNER_HOME}/bin/sonar-scanner"

                            "${SCANNER_HOME}/bin/sonar-scanner" \
                                -Dsonar.projectKey="${SONAR_PROJECT_KEY}" \
                                -Dsonar.projectName="${SONAR_PROJECT_NAME}" \
                                -Dsonar.projectVersion="${PYTHON_PACKAGE_VERSION}" \
                                -Dsonar.sources=. \
                                -Dsonar.sourceEncoding=UTF-8 \
                                -Dsonar.token="${SONAR_TOKEN}" \
                                -Dsonar.exclusions="**/.venv/**,**/.ci-venv/**,**/venv/**,**/__pycache__/**,**/.pytest_cache/**,**/tests/**,**/dist/**,**/build/**"

                            echo "======================================"
                            echo "SONARQUBE ANALYSIS COMPLETED"
                            echo "======================================"
                        '''
                    }
                }
            }
        }
    }
}


        // =========================================================
        // 13. SONARQUBE QUALITY GATE
        // =========================================================

        stage('SonarQube Quality Gate') {

            steps {

                timeout(
                    time: 5,
                    unit: 'MINUTES'
                ) {

                    waitForQualityGate(
                        abortPipeline: true
                    )
                }
            }
        }


        // =========================================================
        // 14. JFROG BUILD ENVIRONMENT
        // =========================================================

        stage('Collect JFrog Build Information') {

            steps {

                withCredentials([

                    string(
                        credentialsId: 'jfrog-user',
                        variable: 'JFROG_USER'
                    ),

                    string(
                        credentialsId: 'jfrog-token',
                        variable: 'JFROG_TOKEN'
                    )

                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "COLLECTING JFROG BUILD INFORMATION"
                        echo "======================================"


                        jf rt build-collect-env \
                            "${JFROG_CLI_BUILD_NAME}" \
                            "${JFROG_CLI_BUILD_NUMBER}" \
                            --server-id="${JFROG_SERVER}"


                        echo "JFrog build environment collected."

                        echo "======================================"
                    '''
                }
            }
        }


        // =========================================================
        // 15. PUBLISH PACKAGE
        // =========================================================

        stage('Publish Package to JFrog') {

            steps {

                withCredentials([

                    string(
                        credentialsId: 'jfrog-user',
                        variable: 'JFROG_USER'
                    ),

                    string(
                        credentialsId: 'jfrog-token',
                        variable: 'JFROG_TOKEN'
                    )

                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "PUBLISHING PYTHON PACKAGE"
                        echo "======================================"

                        echo "Project:"
                        echo "${PROJECT_NAME}"

                        echo "Version:"
                        echo "${PYTHON_PACKAGE_VERSION}"

                        echo "Repository:"
                        echo "${JFROG_LOCAL_REPO}"


                        # -------------------------------------------------
                        # Upload wheel
                        # -------------------------------------------------

                        jf rt upload \
                            "dist/*.whl" \
                            "${JFROG_LOCAL_REPO}/${PROJECT_NAME}/${PYTHON_PACKAGE_VERSION}/" \
                            --server-id="${JFROG_SERVER}" \
                            --flat=true


                        # -------------------------------------------------
                        # Upload source distribution
                        # -------------------------------------------------

                        jf rt upload \
                            "dist/*.tar.gz" \
                            "${JFROG_LOCAL_REPO}/${PROJECT_NAME}/${PYTHON_PACKAGE_VERSION}/" \
                            --server-id="${JFROG_SERVER}" \
                            --flat=true


                        # -------------------------------------------------
                        # Publish Build Info
                        # -------------------------------------------------

                        jf rt build-publish \
                            "${JFROG_CLI_BUILD_NAME}" \
                            "${JFROG_CLI_BUILD_NUMBER}" \
                            --server-id="${JFROG_SERVER}"


                        echo "======================================"
                        echo "JFROG PUBLISH COMPLETED"
                        echo "======================================"
                    '''
                }
            }
        }


        // =========================================================
        // 16. JFROG XRAY
        // =========================================================

        stage('Xray Scan') {

            steps {

                withCredentials([

                    string(
                        credentialsId: 'jfrog-user',
                        variable: 'JFROG_USER'
                    ),

                    string(
                        credentialsId: 'jfrog-token',
                        variable: 'JFROG_TOKEN'
                    )

                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "JFROG XRAY SCAN"
                        echo "======================================"

                        echo "Scanning:"
                        echo "${JFROG_CLI_BUILD_NAME}"

                        echo "Build:"
                        echo "${JFROG_CLI_BUILD_NUMBER}"


                        jf rt build-scan \
                            "${JFROG_CLI_BUILD_NAME}" \
                            "${JFROG_CLI_BUILD_NUMBER}" \
                            --server-id="${JFROG_SERVER}"


                        echo "======================================"
                        echo "XRAY SCAN COMPLETED"
                        echo "======================================"
                    '''
                }
            }
        }


        // =========================================================
        // 17. SBOM
        // =========================================================

        stage('Generate SBOM') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "GENERATING PYTHON SBOM"
                    echo "======================================"

                    PYTHON="${CI_VENV}/bin/python"


                    "${PYTHON}" -m pip install \
                        cyclonedx-bom


                    "${CI_VENV}/bin/cyclonedx-py" \
                        environment \
                        --output-format json \
                        --output-file cyclonedx-sbom.json


                    echo "SBOM generated."

                    ls -lah cyclonedx-sbom.json

                    echo "======================================"
                '''
            }

            post {

                always {

                    archiveArtifacts(

                        artifacts:
                            'cyclonedx-sbom.json',

                        allowEmptyArchive: true,

                        fingerprint: true
                    )
                }
            }
        }


        // =========================================================
        // 18. PUBLISH SBOM TO JFROG
        // =========================================================

        stage('Publish SBOM') {

            steps {

                withCredentials([

                    string(
                        credentialsId: 'jfrog-user',
                        variable: 'JFROG_USER'
                    ),

                    string(
                        credentialsId: 'jfrog-token',
                        variable: 'JFROG_TOKEN'
                    )

                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "PUBLISHING SBOM"
                        echo "======================================"


                        jf rt upload \
                            "cyclonedx-sbom.json" \
                            "${JFROG_LOCAL_REPO}/${PROJECT_NAME}/${PYTHON_PACKAGE_VERSION}/sbom/" \
                            --server-id="${JFROG_SERVER}" \
                            --flat=true


                        echo "SBOM published."

                        echo "======================================"
                    '''
                }
            }
        }


        // =========================================================
        // 19. FINAL RUN RELEASE
        // =========================================================

        stage('Production Release') {

            when {

                expression {

                    params.ENVIRONMENT == 'PROD' &&
                    params.IS_FINAL_RUN == 'true'
                }
            }


            steps {

                script {

                    echo """
====================================================
PRODUCTION RELEASE
====================================================

Project       : ${env.PROJECT_NAME}
Version       : ${env.PYTHON_PACKAGE_VERSION}
Approved By   : ${env.APPROVED_BY}

JFrog Repo    : ${env.JFROG_LOCAL_REPO}

====================================================
"""


                    /*
                     * At this point:
                     *
                     * 1. Tests passed
                     * 2. SonarQube passed
                     * 3. Quality Gate passed
                     * 4. Package built
                     * 5. JFrog Build Info published
                     * 6. Xray completed
                     * 7. SBOM generated
                     * 8. PROD approval received
                     *
                     * The package is already stored in JFrog.
                     *
                     * This stage represents the controlled
                     * production release point.
                     */


                    echo "Production release completed."
                }
            }
        }
    }


    // =============================================================
    // POST ACTIONS
    // =============================================================

    post {

        success {

            echo """
====================================================
PYTHON PIPELINE SUCCESS
====================================================

Project       : ${env.PROJECT_NAME}
Build         : ${BUILD_NUMBER}
Environment   : ${params.ENVIRONMENT}

Package       : ${env.PYTHON_PACKAGE_NAME}
Version       : ${env.PYTHON_PACKAGE_VERSION}

SonarQube     : PASSED
Quality Gate  : PASSED
JFrog         : PUBLISHED
Xray          : COMPLETED
SBOM          : GENERATED

====================================================
"""
        }


        failure {

            echo """
====================================================
PYTHON PIPELINE FAILED
====================================================

Project     : ${env.PROJECT_NAME}
Build       : ${BUILD_NUMBER}
Environment : ${params.ENVIRONMENT}

Check the failed stage and Jenkins console.

====================================================
"""
        }


        aborted {

            echo """
====================================================
PYTHON PIPELINE ABORTED
====================================================

Project     : ${env.PROJECT_NAME}
Build       : ${BUILD_NUMBER}
Environment : ${params.ENVIRONMENT}

====================================================
"""
        }


        always {

            sh '''
                rm -rf .ci-venv || true
                rm -rf .venv || true
                rm -rf __pycache__ || true
                rm -rf .pytest_cache || true
                rm -rf build || true
                rm -rf *.egg-info || true
            '''
        }
    }
}