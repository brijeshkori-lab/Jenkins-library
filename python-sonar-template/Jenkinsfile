pipeline {

    agent any

    parameters {

        string(
            name: 'GIT_URL',
            defaultValue: '',
            description: 'Git repository URL of the Python application'
        )

        string(
            name: 'GIT_BRANCH',
            defaultValue: 'main',
            description: 'Git branch to build'
        )

        choice(
            name: 'PYTHON_VERSION',
            choices: [
                'python3',
                'python3.8',
                'python3.9',
                'python3.10',
                'python3.11',
                'python3.12'
            ],
            description: 'Python executable available on the Jenkins agent'
        )

        string(
            name: 'SONAR_PROJECT_KEY',
            defaultValue: 'python-app',
            description: 'SonarQube project key'
        )

        string(
            name: 'SONAR_PROJECT_NAME',
            defaultValue: 'python-app',
            description: 'SonarQube project name'
        )

        string(
            name: 'REQUIREMENTS_FILE',
            defaultValue: 'requirements.txt',
            description: 'Python dependency file'
        )

        string(
            name: 'TEST_COMMAND',
            defaultValue: 'pytest',
            description: 'Command used to execute Python tests'
        )
    }

    environment {

        SONAR_SERVER = 'SonarQubeLocal'

        SONAR_TOKEN_CREDENTIAL = 'jenkins-ci'

        VENV_DIR = '.venv'
    }

    stages {

        stage('Validate Parameters') {

            steps {

                script {

                    if (!params.GIT_URL?.trim()) {
                        error('GIT_URL is required.')
                    }

                    if (!params.SONAR_PROJECT_KEY?.trim()) {
                        error('SONAR_PROJECT_KEY is required.')
                    }

                    if (!params.SONAR_PROJECT_NAME?.trim()) {
                        error('SONAR_PROJECT_NAME is required.')
                    }

                    echo """
====================================================
PYTHON APPLICATION TEMPLATE
====================================================
Git URL          : ${params.GIT_URL}
Git Branch       : ${params.GIT_BRANCH}
Python Version   : ${params.PYTHON_VERSION}
Sonar Project    : ${params.SONAR_PROJECT_KEY}
Requirements     : ${params.REQUIREMENTS_FILE}
Test Command     : ${params.TEST_COMMAND}
====================================================
"""
                }
            }
        }


        stage('Check Python') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "CHECKING PYTHON"
                    echo "======================================"

                    command -v "${PYTHON_VERSION}"

                    "${PYTHON_VERSION}" --version

                    echo "Python is available."
                '''
            }
        }


        stage('Checkout') {

            steps {

                deleteDir()

                git(
                    url: params.GIT_URL,
                    branch: params.GIT_BRANCH,
                    credentialsId: 'github-credentials'
                )
            }
        }


        stage('Create Virtual Environment') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "CREATING PYTHON VIRTUAL ENVIRONMENT"
                    echo "======================================"

                    "${PYTHON_VERSION}" -m venv "${VENV_DIR}"

                    . "${VENV_DIR}/bin/activate"

                    python --version

                    python -m pip install --upgrade pip setuptools wheel

                    echo "Virtual environment created."
                '''
            }
        }


        stage('Install Dependencies') {

            steps {

                sh '''
                    set -e

                    echo "======================================"
                    echo "INSTALLING DEPENDENCIES"
                    echo "======================================"

                    . "${VENV_DIR}/bin/activate"

                    if [ -f "${REQUIREMENTS_FILE}" ]; then

                        echo "Installing dependencies from ${REQUIREMENTS_FILE}"

                        pip install -r "${REQUIREMENTS_FILE}"

                    else

                        echo "No ${REQUIREMENTS_FILE} found."
                        echo "Skipping dependency installation."

                    fi

                    echo "Dependencies installation completed."
                '''
            }
        }


       stage('Test') {

    steps {

        sh '''
            set -eux

            echo "======================================"
            echo "RUNNING PYTHON TESTS"
            echo "======================================"

            . "${VENV_DIR}/bin/activate"

            echo "Current directory:"
            pwd

            echo "Workspace:"
            echo "${WORKSPACE}"

            echo "Project files:"
            ls -la

            echo "Tests:"
            find tests -maxdepth 2 -type f -print

            echo "======================================"
            echo "PYTHON INFORMATION"
            echo "======================================"

            python --version
            python -c "import sys; print('\\n'.join(sys.path))"

            echo "======================================"
            echo "CONFIGURING PYTHONPATH"
            echo "======================================"

            export PYTHONPATH="${WORKSPACE}:${PYTHONPATH:-}"

            echo "PYTHONPATH=${PYTHONPATH}"

            echo "======================================"
            echo "TESTING APPLICATION IMPORT"
            echo "======================================"

            python -c "from app import greet; print(greet('Jenkins'))"

            echo "Application import successful."

            echo "======================================"
            echo "RUNNING PYTEST"
            echo "======================================"

            python -m pytest -v

            echo "======================================"
            echo "PYTHON TESTS PASSED"
            echo "======================================"
        '''
    }
}


        stage('SonarQube Scan') {

            steps {

                script {

                    def scannerHome = tool 'SonarQubeLocal'

                    withCredentials([
                        string(
                            credentialsId: env.SONAR_TOKEN_CREDENTIAL,
                            variable: 'SONAR_TOKEN'
                        )
                    ]) {

                        withSonarQubeEnv(env.SONAR_SERVER) {

                            sh """
                                set -e

                                echo "======================================"
                                echo "SONARQUBE ANALYSIS"
                                echo "======================================"

                                ${scannerHome}/bin/sonar-scanner \\
                                    -Dsonar.projectKey="${params.SONAR_PROJECT_KEY}" \\
                                    -Dsonar.projectName="${params.SONAR_PROJECT_NAME}" \\
                                    -Dsonar.sources=. \\
                                    -Dsonar.sourceEncoding=UTF-8 \\
                                    -Dsonar.exclusions="**/.venv/**,**/venv/**,**/__pycache__/**,**/.pytest_cache/**,**/tests/**" \\
                                    -Dsonar.token="\${SONAR_TOKEN}"

                                echo "SonarQube scan completed."
                            """
                        }
                    }
                }
            }
        }


        stage('SonarQube Quality Gate') {

            steps {

                timeout(
                    time: 10,
                    unit: 'MINUTES'
                ) {

                    script {

                        def qualityGate = waitForQualityGate(
                            abortPipeline: false
                        )

                        echo "======================================"
                        echo "SONARQUBE QUALITY GATE"
                        echo "======================================"

                        echo "Quality Gate Status: ${qualityGate.status}"

                        if (qualityGate.status != 'OK') {

                            error(
                                "SonarQube Quality Gate FAILED: ${qualityGate.status}"
                            )
                        }

                        echo "SonarQube Quality Gate PASSED."
                    }
                }
            }
        }
    }


    post {

        success {

            echo '''
==============================================
PYTHON PIPELINE SUCCESS
==============================================

Application build and SonarQube analysis
completed successfully.

==============================================
'''
        }

        failure {

            echo '''
==============================================
PYTHON PIPELINE FAILED
==============================================

Please check the failed stage and Jenkins
console output.

==============================================
'''
        }

        always {

            sh '''
                rm -rf .venv || true
                rm -rf __pycache__ || true
                rm -rf .pytest_cache || true
            '''
        }
    }
}